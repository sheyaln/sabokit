# {{ ansible_managed }}
# Allow the docker group (and the deploy user) to invoke the fetch-secrets
# script as the scw-secrets service user. Containers therefore never see the
# SCW CLI config or the API key directly — only the resolved secret values
# that fetch-secrets writes into the requested tmpfs directory.

%docker ALL=({{ scw_secrets_user }}) NOPASSWD: {{ scw_secrets_bin_dir }}/fetch-secrets
{% if scw_secrets_sudo_user is defined and scw_secrets_sudo_user | length > 0 %}
{{ scw_secrets_sudo_user }} ALL=({{ scw_secrets_user }}) NOPASSWD: {{ scw_secrets_bin_dir }}/fetch-secrets
{% endif %}
