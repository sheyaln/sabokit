# [auth]
# auth-prod ansible_host=203.0.113.20 ansible_user=ubuntu
#
# [management]
# mgmt-prod ansible_host=203.0.113.30 ansible_user=ubuntu

[all:vars]
ansible_python_interpreter=/usr/bin/python3
