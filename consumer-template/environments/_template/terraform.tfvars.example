# Copy to terraform.tfvars (gitignored) and fill in.
#
# Credentials can also come from TF_VAR_* env vars (preferred in CI):
#   export TF_VAR_scaleway_access_key=...
#   export TF_VAR_scaleway_secret_key=...
#
# Do NOT set authentik_admin_token here. deploy.sh fetches it from the
# bootstrap admin secret created by phase 1 and re-exports it as
# TF_VAR_authentik_admin_token before the rest of the apply.

scaleway_access_key = "SCWXXXXXXXXXXXXXXXXX"
scaleway_secret_key = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
scaleway_project_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

org_slug    = "acme"
org_name    = "Acme Cooperative"
environment = "prod"          # match the env directory name

base_domain    = "example.org"
gateway_domain = "auth.example.org"
infra_email    = "ops@example.org"
# mgmt_domain  = "ops.example.org"  # optional; defaults to base_domain

# compute_hosts can be overridden here if you need a different topology
# than the default (single "apps" DEV1-L host).
#
# Multi-host prod: one VM per role.
#   compute_hosts = {
#     apps     = { instance_type = "DEV1-L", role = "apps",     ansible_group = "apps" }
#     identity = { instance_type = "DEV1-M", role = "identity", ansible_group = "identity" }
#   }
#
# Single-VM staging/dev: one VM serves multiple Ansible plays. Use
# ansible_groups to list every group the play-selectors look for.
#   compute_hosts = {
#     staging = {
#       instance_type  = "DEV1-M"
#       role           = "apps"
#       ansible_group  = "staging"
#       ansible_groups = ["apps", "identity"]
#     }
#   }

apps = {
  outline = {
    enabled  = true
    hostname = "wiki.example.org"

    # deployment_host_key must be a key in compute_hosts above. Defaults to
    # "apps". Override when your topology renames hosts:
    # deployment_host_key = "tools"
  }

  # Steward: simplified Authentik admin UI for non-technical org admins.
  # Members of the `admin_group_name` group in Authentik can sign in.
  # steward = {
  #   enabled  = true
  #   hostname = "members.example.org"
  #
  #   # Optional: pin the image. Defaults to ghcr.io/sheyaln/sabokit-steward:latest.
  #   # image_tag = "v1.0.0"
  #
  #   # Optional: enable an enrollment flow so new members get an invite.
  #   # Leave empty until you've created/imported an enrollment flow in Authentik.
  #   # invite_flow_slug = "default-source-enrollment"
  # }

  # Vikunja: task and project tracker. OIDC-only by default.
  # vikunja = {
  #   enabled  = true
  #   hostname = "tasks.example.org"
  #
  #   # Optional: server timezone (IANA). Default UTC.
  #   # timezone = "America/New_York"
  #
  #   # Optional: turn on email. Requires a Scaleway secret named "smtp-config"
  #   # carrying {host, port, username, password}; leave empty to disable mail.
  #   # smtp_from_email = "tasks@example.org"
  # }

  # BentoPDF: browser PDF toolkit. Forward-auth (no OIDC inside the app).
  # No DB, no storage — fully stateless.
  # bentopdf = {
  #   enabled  = true
  #   hostname = "pdf.example.org"
  # }

  # Notifuse: transactional + marketing email. OIDC via Authentik; defaults
  # to admin-only access. SECRET_KEY and root admin password are immutable
  # after first apply — see platform/apps/notifuse/README.md.
  # notifuse = {
  #   enabled          = true
  #   hostname         = "email.example.org"
  #   root_admin_email = "ops@example.org"
  #   smtp_from_email  = "notify@example.org"
  # }

  # nextcloud = {
  #   enabled             = true
  #   hostname            = "cloud.example.org"
  #   deployment_host_key = "apps"
  # }
}

# SMTP is OPTIONAL. Empty (the default) means the identity flows still
# apply but every email step no-ops at runtime — useful for first cold-start.
# To enable outbound email later: create a Scaleway secret with a JSON
# payload like {"smtp_host": "...", "smtp_port": 587, "smtp_username":
# "...", "smtp_password": "..."}, then uncomment and set the name below
# and re-apply. No resource re-create needed.
#
# smtp_secret_name = "smtp-config"
