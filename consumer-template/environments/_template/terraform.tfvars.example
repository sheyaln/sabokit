# Copy to terraform.tfvars (gitignored) and fill in.
#
# Credentials can also come from TF_VAR_* env vars (preferred in CI):
#   export TF_VAR_scaleway_access_key=...
#   export TF_VAR_scaleway_secret_key=...
#
# Do NOT set authentik_admin_token here. deploy.sh fetches it from the
# bootstrap admin secret created by phase 1 and re-exports it as
# TF_VAR_authentik_admin_token before the rest of the apply.

scaleway_access_key = "SCWXXXXXXXXXXXXXXXXX"
scaleway_secret_key = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
scaleway_project_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

org_slug    = "acme"
org_name    = "Acme Cooperative"
environment = "prod"          # match the env directory name

base_domain    = "example.org"
gateway_domain = "auth.example.org"
infra_email    = "ops@example.org"
# mgmt_domain  = "ops.example.org"  # optional; defaults to base_domain

# compute_hosts can be overridden here if you need a different topology
# than the default (single "apps" DEV1-L host).
#
# Multi-host prod: one VM per role.
#   compute_hosts = {
#     apps     = { instance_type = "DEV1-L", role = "apps",     ansible_group = "apps" }
#     identity = { instance_type = "DEV1-M", role = "identity", ansible_group = "identity" }
#   }
#
# Single-VM staging/dev: one VM serves multiple Ansible plays. Use
# ansible_groups to list every group the play-selectors look for.
#   compute_hosts = {
#     staging = {
#       instance_type  = "DEV1-M"
#       role           = "apps"
#       ansible_group  = "staging"
#       ansible_groups = ["apps", "identity"]
#     }
#   }

# Tier DAG (required). Models the org's authority hierarchy as a list of
# slots, each holding one or more peer roles at that rank. peer_name is the
# stable token bundles' tier_access_level matches against; group_name is the
# underlying Authentik group's display name.
#
# Cascade-up semantics: an app scoped to peer P in slot S admits P's own
# group + every group in every strictly-higher slot. Peers in the same slot
# do NOT see each other through the cascade — they are equal-rank but
# independent.
#
# Below is a generic L1-L4 example with a single peer per slot. Add more
# peers in any slot for parallel roles (e.g. multiple L3 officers each
# owning their own scope).
identity = {
  tier_slots = [
    # Slot 1 (lowest privilege)
    { name = "l1", peers = { member = "member" } },
    # Slot 2
    { name = "l2", peers = { delegate = "delegate" } },
    # Slot 3 — add parallel peers here for parallel officer roles
    { name = "l3", peers = { treasurer = "treasurer" } },
    # Slot 4 (highest) — admin must exist as a peer in some slot
    { name = "l4", peers = { admin = "admin" } },
  ]
}

apps = {
  outline = {
    enabled  = true
    hostname = "wiki.example.org"

    # deployment_host_key must be a key in compute_hosts above. Defaults to
    # "apps". Override when your topology renames hosts:
    # deployment_host_key = "tools"
  }

  # Steward: simplified Authentik admin UI for non-technical org admins.
  # Members of the `admin_group_name` group in Authentik can sign in.
  # steward = {
  #   enabled  = true
  #   hostname = "members.example.org"
  #
  #   # Optional: pin the image. Defaults to ghcr.io/sheyaln/sabokit-steward:latest.
  #   # image_tag = "v1.0.0"
  #
  #   # Optional: enable an enrollment flow so new members get an invite.
  #   # Leave empty until you've created/imported an enrollment flow in Authentik.
  #   # invite_flow_slug = "default-source-enrollment"
  # }

  # Vikunja: task and project tracker. OIDC-only by default.
  # vikunja = {
  #   enabled  = true
  #   hostname = "tasks.example.org"
  #
  #   # Optional: server timezone (IANA). Default UTC.
  #   # timezone = "America/New_York"
  #
  #   # Optional: turn on email. Requires a Scaleway secret named "smtp-config"
  #   # carrying {host, port, username, password}; leave empty to disable mail.
  #   # smtp_from_email = "tasks@example.org"
  # }

  # BentoPDF: browser PDF toolkit. Forward-auth (no OIDC inside the app).
  # No DB, no storage — fully stateless.
  # bentopdf = {
  #   enabled  = true
  #   hostname = "pdf.example.org"
  # }

  # Notifuse: DEPRECATED in v2.16.0 — use broadsheet below for new deploys.
  # Stays one more v2.x cycle for migration headroom; v3.0.0 drops it.
  # SECRET_KEY and root admin password are immutable after first apply.
  # See platform/apps/notifuse/README.md.
  # notifuse = {
  #   enabled          = true
  #   hostname         = "email.example.org"
  #   root_admin_email = "ops@example.org"
  #   smtp_from_email  = "notify@example.org"
  # }

  # Broadsheet: newsletters + transactional email (sabokit-broadsheet fork of
  # notifuse). OIDC via Authentik; defaults to admin-only access. SECRET_KEY
  # and root admin password are immutable after first apply.
  # See platform/apps/broadsheet/README.md.
  # broadsheet = {
  #   enabled          = true
  #   hostname         = "email.example.org"
  #   root_admin_email = "ops@example.org"
  #   smtp_from_email  = "notify@example.org"
  # }

  # Privacy policy: public static page (no auth — must be reachable for
  # compliance). Supply your HTML + logo via the Ansible role vars.
  # privacy_policy = {
  #   enabled  = true
  #   hostname = "privacy.example.org"
  # }

  # Nextcloud: file sync + collaboration + OnlyOffice (document editing) +
  # Talk HPB (video calls). One stack, three hostnames. Talk HPB requires
  # UDP/TCP 3478 + UDP 49152-49252 to be open in the security group on top of
  # the host UFW. Pin image_tag to a major (e.g. 32-apache) — one-major-at-
  # a-time upgrades only.
  # nextcloud = {
  #   enabled              = true
  #   hostname             = "cloud.example.org"
  #   onlyoffice_hostname  = "docs.example.org"
  #   talk_hostname        = "talk.example.org"
  #   smtp_from_email      = "cloud@example.org"
  #   default_phone_region = "US"
  # }

  # Decidim: participatory democracy platform. Multi-container (web +
  # sidekiq), postgres + S3, OIDC. Requires organization_name +
  # system_admin_email at minimum.
  # decidim = {
  #   enabled            = true
  #   hostname           = "voting.example.org"
  #   organization_name  = "Example Assembly"
  #   system_admin_email = "ops@example.org"
  #   smtp_from_email    = "voting@example.org"
  #   image_tag          = "0.28"
  # }

  # Jitsi: video conferencing. Requires UDP 10000 open in the security
  # group on top of the host UFW (the Ansible role handles UFW). The OIDC
  # adapter brokers Authentik OIDC → Jitsi JWT.
  # jitsi = {
  #   enabled  = true
  #   hostname = "meet.example.org"
  # }

  # EspoCRM: PHP CRM. Member-entity bootstrap is opt-in (sets up
  # constituent/dues tracking on top of the generic CRM).
  # espocrm = {
  #   enabled                        = true
  #   hostname                       = "crm.example.org"
  #   timezone                       = "America/New_York"
  #   enable_member_entity_bootstrap = false
  # }

  # n8n: workflow automation. Defaults to bind-mount the hooks.js shim;
  # set build_from_source = true only if you need python3 for Execute
  # Command nodes.
  # n8n = {
  #   enabled  = true
  #   hostname = "automate.example.org"
  #   timezone = "America/New_York"
  # }

  # Backrest: restic-based per-host backups. ONE module instance per host
  # to back up — add a second backrest_<host> module block in
  # modules/stack/apps.tf for each. Restic password lifecycle is
  # ignore_changes; rotating breaks every snapshot.
  # backrest_mgmt = {
  #   enabled       = true
  #   hostname      = "backup.mgmt.example.org"
  #   instance_name = "mgmt"
  #   backup_plans = [
  #     {
  #       id       = "daily"
  #       paths    = ["/backup-sources/opt", "/backup-sources/docker-volumes"]
  #       schedule = { cron = "0 3 * * *" }
  #       retention = {
  #         hourly  = 24
  #         daily   = 7
  #         weekly  = 4
  #         monthly = 12
  #         yearly  = 3
  #       }
  #     },
  #   ]
  # }
}

# SMTP is OPTIONAL. Empty (the default) means the identity flows still
# apply but every email step no-ops at runtime — useful for first cold-start.
# To enable outbound email later: create a Scaleway secret with a JSON
# payload like {"smtp_host": "...", "smtp_port": 587, "smtp_username":
# "...", "smtp_password": "..."}, then uncomment and set the name below
# and re-apply. No resource re-create needed.
#
# smtp_secret_name = "smtp-config"
