# Per-env runtime artifacts. config.tf, secrets.tf, and sibling consumer .tf
# files ARE committable (and should be committed) — they're the auditable
# infra spec. Only generated state + remote-backend config stays out of git.
.terraform/
.terraform.lock.hcl
backend.hcl
inventory.ini
.tf-output.json
.ansible-vars.json
*.tfplan
*.tfstate
*.tfstate.*
