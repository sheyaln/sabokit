# Per-env runtime artifacts. The config YAML (common.yml one level up, env.yml,
# hosts.yml, infra/identity/operations/application.yml) and every layer's
# stack.tf/providers.tf/outputs.tf ARE committable — they're the auditable infra
# spec. Only generated state, fetched secrets, and remote-backend config stay out.
*/.terraform/
*/.terraform.lock.hcl
*/backend.hcl
*/*.tfplan
*/*.tfstate
*/*.tfstate.*
.env
.envrc
inventory.ini
.tf-output*.json
.ansible-vars*.json
.enabled_apps*.json
