# Per-env runtime artifacts. config.tf, env.tf, secrets.tf, and sibling
# consumer .tf files ARE committable (and should be committed) — they're the
# auditable infra spec, along with environments/env-values.yml one level up.
# Only generated state + remote-backend config stays out of git.
.terraform/
.terraform.lock.hcl
backend.hcl
inventory.ini
.tf-output.json
.ansible-vars.json
*.tfplan
*.tfstate
*.tfstate.*
