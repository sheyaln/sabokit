# Copy to terraform.tfvars (gitignored) and fill in.
#
# Credentials can also be supplied via TF_VAR_* environment variables
# (preferred for CI):
#   export TF_VAR_scaleway_access_key=...
#   export TF_VAR_scaleway_secret_key=...
#   export TF_VAR_authentik_admin_token=...

# ── Credentials ─────────────────────────────────────────────────────────────
scaleway_access_key   = "SCWXXXXXXXXXXXXXXXXX"
scaleway_secret_key   = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
scaleway_project_id   = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
authentik_admin_token = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── Organization ────────────────────────────────────────────────────────────
org_slug    = "acme"          # short slug; used in resource names
environment = "prod"

# ── Domains (must be registered + delegated to Scaleway DNS) ────────────────
base_domain    = "example.org"
gateway_domain = "auth.example.org"
# mgmt_domain  = "ops.example.org"   # optional; defaults to base_domain

# ── Compute topology ────────────────────────────────────────────────────────
# Each host becomes a Scaleway instance + an Ansible inventory entry under
# the named ansible_group. Default config provisions one "apps" host; add
# more for separate management/auth hosts.
#
# compute_hosts = {
#   apps = {
#     instance_type = "DEV1-L"
#     disk_size     = 100
#     role          = "apps"
#     ansible_group = "apps"
#     protected     = true
#   }
#   auth = {
#     instance_type = "DEV1-M"
#     disk_size     = 45
#     role          = "auth"
#     ansible_group = "auth"
#   }
# }

# ── Apps ────────────────────────────────────────────────────────────────────
# One entry per app you want to enable. Defaults are sensible; only the
# hostname is strictly required when enabled = true.

apps = {
  outline = {
    enabled  = true
    hostname = "wiki.example.org"
  }

  # nextcloud = {
  #   enabled  = true
  #   hostname = "cloud.example.org"
  # }
  #
  # vikunja = {
  #   enabled  = true
  #   hostname = "tasks.example.org"
  # }
  #
  # ... more apps as bundles ship
}
