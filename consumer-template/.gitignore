# Consumer-side gitignore. Copy along with the template.

# Terraform
**/.terraform/
**/.terraform.lock.hcl
**/*.tfstate
**/*.tfstate.*
**/*.tfvars
!**/*.tfvars.example
**/*.tfplan
crash.log

# Per-env runtime files
**/backend.hcl
!**/backend.hcl.example
**/inventory.ini
!**/inventory.ini.example
**/.tf-output.json
**/.ansible-vars.json

# Ansible runtime
*.retry
.ansible/
.vault_pass.txt

# Secrets — never committed. Per-env NON-secret values are committed in
# environments/env-values.yml; only credentials stay out of git.
.env
.env.*
!.env.example
.envrc
!.envrc.example
*.pem
*.key
credentials.json

# OS
.DS_Store
._*
Thumbs.db
