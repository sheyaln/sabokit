# Consumer-side gitignore. Copy this file along with the template.

# Terraform state and credentials
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
*.tfplan
crash.log
.terraform.lock.hcl

# Ansible
inventory.ini
!inventory.ini.example
group_vars/all.yml
!group_vars/all.yml.example
*.retry
.ansible/
.vault_pass.txt

# Terraform→Ansible bridge
ansible/enabled_apps.json

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# OS
.DS_Store
._*
Thumbs.db
