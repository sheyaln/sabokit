# {{ ansible_managed }}
# Authentik environment — DO NOT EDIT MANUALLY.
# Regenerated on every ansible-playbook run from Scaleway Secret Manager.

# ── Image ──
AUTHENTIK_IMAGE={{ authentik_image }}
AUTHENTIK_TAG={{ authentik_version }}

# ── Domain ──
AUTHENTIK_DOMAIN={{ authentik_hostname }}
AUTHENTIK_LEGACY_DOMAIN={{ authentik_legacy_hostname }}

# ── Server-side application secret ──
AUTHENTIK_SECRET_KEY="{{ authentik_server.secret_key | regex_replace('\$', '$$') }}"

# ── Database ──
POSTGRES_HOST={{ authentik_postgres.host }}
POSTGRES_PORT={{ authentik_postgres.port }}
POSTGRES_USER={{ authentik_postgres.username }}
POSTGRES_DB={{ authentik_postgres.dbname }}
POSTGRES_PASSWORD="{{ authentik_postgres.password | regex_replace('\$', '$$') }}"

AUTHENTIK_POSTGRESQL__HOST={{ authentik_postgres.host }}
AUTHENTIK_POSTGRESQL__PORT={{ authentik_postgres.port }}
AUTHENTIK_POSTGRESQL__USER={{ authentik_postgres.username }}
AUTHENTIK_POSTGRESQL__NAME={{ authentik_postgres.dbname }}
AUTHENTIK_POSTGRESQL__PASSWORD="{{ authentik_postgres.password | regex_replace('\$', '$$') }}"
AUTHENTIK_POSTGRESQL__CONN_MAX_AGE=300

# ── Bootstrap admin user (used on first boot only) ──
# AUTHENTIK_BOOTSTRAP_PASSWORD and _EMAIL create the admin user.
# AUTHENTIK_BOOTSTRAP_TOKEN creates a matching API Token with that exact key
# in the same first-boot migration — meaning the Terraform authentik provider
# can authenticate with the same value Terraform pre-generated and stored in
# the admin secret. Subsequent boots ignore the env vars (rows already exist).
AUTHENTIK_BOOTSTRAP_PASSWORD="{{ authentik_admin.password | regex_replace('\$', '$$') }}"
AUTHENTIK_BOOTSTRAP_EMAIL={{ authentik_admin.email }}
{% if authentik_admin.api_token is defined and authentik_admin.api_token | length > 0 %}
AUTHENTIK_BOOTSTRAP_TOKEN="{{ authentik_admin.api_token | regex_replace('\$', '$$') }}"
{% endif %}

{% if authentik_smtp_secret_id | length > 0 %}
# ── SMTP ──
AUTHENTIK_EMAIL__HOST={{ authentik_smtp.host }}
AUTHENTIK_EMAIL__PORT={{ authentik_smtp.port | default('465') }}
AUTHENTIK_EMAIL__USERNAME={{ authentik_smtp.username | default('') }}
AUTHENTIK_EMAIL__PASSWORD="{{ authentik_smtp.password | default('') | regex_replace('\$', '$$') }}"
AUTHENTIK_EMAIL__FROM="{{ authentik_smtp.from | default('') }}"
AUTHENTIK_EMAIL__USE_TLS={{ authentik_smtp.use_tls | default('false') }}
AUTHENTIK_EMAIL__USE_SSL={{ authentik_smtp.use_ssl | default('true') }}
AUTHENTIK_EMAIL__TIMEOUT=10
{% endif %}

# ── Telemetry off ──
AUTHENTIK_DISABLE_STARTUP_ANALYTICS=true
AUTHENTIK_DISABLE_UPDATE_CHECK=false
AUTHENTIK_ERROR_REPORTING__ENABLED=false

# ── Logs / metrics ──
AUTHENTIK_LOG_LEVEL=info
AUTHENTIK_METRICS__ENABLED=true

AUTHENTIK_NETWORK_INTERNAL=authentik-internal

{% if authentik_media_s3_secret_id | length > 0 %}
# ── S3-compatible media storage ──
AUTHENTIK_STORAGE__BACKEND=s3
AUTHENTIK_STORAGE__S3__ACCESS_KEY={{ authentik_media_s3.access_key }}
AUTHENTIK_STORAGE__S3__SECRET_KEY="{{ authentik_media_s3.secret_key | regex_replace('\$', '$$') }}"
AUTHENTIK_STORAGE__S3__BUCKET_NAME={{ authentik_media_s3.bucket_name }}
AUTHENTIK_STORAGE__S3__REGION={{ authentik_media_s3.region }}
AUTHENTIK_STORAGE__S3__ENDPOINT={{ authentik_media_s3.endpoint }}
AUTHENTIK_STORAGE__S3__CUSTOM_DOMAIN={{ authentik_media_s3.custom_domain }}
AUTHENTIK_STORAGE__S3__SECURE_URLS=true
AUTHENTIK_STORAGE__S3__ADDRESSING_STYLE=path
{% endif %}

# ── Private-IP metrics binding ──
PRIVATE_IP={{ authentik_metrics_bind_ip | default('0.0.0.0', true) }}
