      "id": "slack-signup",
      "name": "Slack Signup",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.4,
      "position": [720, 120],
      "credentials": {
        "slackApi": { "name": "Slack account" }
      }
    },
    {
      "parameters": {
        "jsCode": "// Persist the signup Slack message ts keyed by user email so the later\n// activation notification can post as a thread reply.\nconst webhookItems = $('Webhook').all();\nif (!webhookItems.length) throw new Error('No data from Webhook node');\nconst email = webhookItems[0].json.body?.user?.email;\nif (!email) throw new Error('No user.email in webhook data');\n\nconst slackResponse = $input.first().json;\nconst threadTs = slackResponse.message?.ts || slackResponse.ts || slackResponse.message_timestamp;\nif (!threadTs) throw new Error('No thread_ts found in Slack response');\n\nlet threads = $getWorkflowStaticData('global').threads || {};\nthreads[email] = { ts: threadTs, timestamp: Date.now() };\n\n// Evict entries older than 30 days so the static data bag stays small.\nconst thirtyDaysAgo = Date.now() - (30 * 24 * 60 * 60 * 1000);\nthreads = Object.fromEntries(\n  Object.entries(threads).filter(([_, v]) => v.timestamp > thirtyDaysAgo)\n);\n$getWorkflowStaticData('global').threads = threads;\n\nreturn [{ json: { email, threadTs, success: true } }];"
      },
      "id": "store-thread",
      "name": "Store Thread TS",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [940, 120]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "={{ $env.WORKFLOW_ID_BROADSHEET_SUBSCRIBE }}",
          "mode": "id"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "email": "={{ $('Webhook').item.json.body.user.email }}",
            "firstName": "={{ ($('Webhook').item.json.body.user.name || '').split(' ').slice(0, -1).join(' ') || ($('Webhook').item.json.body.user.name || '').split(' ')[0] || '' }}",
            "lastName": "={{ ($('Webhook').item.json.body.user.name || '').split(' ').length > 1 ? ($('Webhook').item.json.body.user.name || '').split(' ').slice(-1)[0] : '' }}"
          },
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "options": {}
      },
      "id": "exec-notifuse-signup",
      "name": "Subscribe (Signup)",
      "type": "n8n-nodes-base.executeWorkflow",
