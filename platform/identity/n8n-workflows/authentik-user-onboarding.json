      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "={{ $env.SLACK_CHANNEL_NEW_SIGNUPS }}",
          "mode": "name"
        },
        "messageType": "block",
        "blocksUi": "={\n  \"blocks\": [\n    {\n      \"type\": \"header\",\n      \"text\": {\n        \"type\": \"plain_text\",\n        \"text\": \"🆕 New User Enrollment\",\n        \"emoji\": true\n      }\n    },\n    {\n      \"type\": \"section\",\n      \"fields\": [\n        { \"type\": \"mrkdwn\", \"text\": \"*Name:*\\n{{ $('Webhook').item.json.body.user.name }}\" },\n        { \"type\": \"mrkdwn\", \"text\": \"*Email:*\\n{{ $('Webhook').item.json.body.user.email }}\" },\n        { \"type\": \"mrkdwn\", \"text\": \"*Signup Method:*\\n{{ $('Webhook').item.json.body.user.signup_method }}\" },\n        { \"type\": \"mrkdwn\", \"text\": \"*Status:*\\n{{ $('Webhook').item.json.body.user.status }}\" }\n      ]\n    },\n    {\n      \"type\": \"section\",\n      \"text\": {\n        \"type\": \"mrkdwn\",\n        \"text\": \"{{ $('Webhook').item.json.body.user.needs_activation ? ':warning: *Action required:* review and activate this account only if you have verified the user is a legitimate member of your organisation.' : ':white_check_mark: User is already active \\u2014 no action needed.' }}\"\n      }\n    },\n    {\n      \"type\": \"actions\",\n      \"elements\": [\n        {\n          \"type\": \"button\",\n          \"style\": \"primary\",\n          \"text\": { \"type\": \"plain_text\", \"text\": \"Manage Users\", \"emoji\": true },\n          \"url\": \"{{ $('Webhook').item.json.body.gateway_url }}/if/admin/#/identity/users\"\n        }\n      ]\n    }\n  ]\n}\n",
        "text": "=",
        "otherOptions": {}
