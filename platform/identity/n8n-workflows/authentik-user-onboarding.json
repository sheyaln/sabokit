    {
      "parameters": {},
      "id": "signup-done",
      "name": "Signup Done",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1380, 120]
    },
    {
      "parameters": {
        "jsCode": "// Resolve the signup thread_ts for this email so the activation notice\n// posts as a reply in the original signup thread. Falls back to no thread\n// (plain top-level post) if neither source has it.\nconst inputData = $input.first().json;\nconst email = inputData.body?.user?.email;\nif (!email) {\n  return [{ json: { threadTs: '', found: false, error: 'No email in payload', ...inputData } }];\n}\n\n// 1. Authentik may forward the original signup correlation id.\nconst payloadThreadTs = inputData.body?.user?.signup_correlation_id;\nif (payloadThreadTs) {\n  return [{ json: { threadTs: payloadThreadTs, found: true, source: 'authentik', ...inputData } }];\n}\n\n// 2. Fallback: look it up in workflow static data populated by the signup branch.\nconst threads = $getWorkflowStaticData('global').threads || {};\nconst thread = threads[email];\nif (thread && thread.ts) {\n  return [{ json: { threadTs: thread.ts, found: true, source: 'static_data', ...inputData } }];\n}\nreturn [{ json: { threadTs: '', found: false, ...inputData } }];"
      },
      "id": "get-thread",
      "name": "Get Thread TS",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
