        "blocksUi": "={\n  \"blocks\": [\n    {\n      \"type\": \"section\",\n      \"text\": {\n        \"type\": \"mrkdwn\",\n        \"text\": \":white_check_mark: *User Activated*\\n*{{ $('Webhook').item.json.body.user.name }}* ({{ $('Webhook').item.json.body.user.email }}) has been activated by {{ $('Webhook').item.json.body.user.activated_by }}.\\nSignup method: {{ $('Webhook').item.json.body.user.signup_method }}\"\n      }\n    }\n  ]\n}\n",
        "text": "=",
