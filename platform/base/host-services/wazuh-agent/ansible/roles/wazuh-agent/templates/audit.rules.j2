# {{ ansible_managed }}
# Wazuh FIM audit rules. Targets security-relevant file changes only;
# avoids broad rules (-S execve / -S connect) that flood the bus.

# User / group management
-w /etc/passwd          -p wa -k passwd_changes
-w /etc/group           -p wa -k group_changes
-w /etc/shadow          -p wa -k shadow_changes
-w /etc/gshadow         -p wa -k shadow_changes

# Privilege escalation
-w /etc/sudoers         -p wa -k sudoers_changes
-w /etc/sudoers.d/      -p wa -k sudoers_changes
-w /etc/pam.d/          -p wa -k pam_changes

# SSH configuration + authorized keys
-w /etc/ssh/sshd_config     -p wa -k sshd_config
-w /etc/ssh/sshd_config.d/  -p wa -k sshd_config
-w /root/.ssh/              -p wa -k ssh_keys

# Scheduled jobs
-w /etc/crontab         -p wa -k cron_changes
-w /etc/cron.d/         -p wa -k cron_changes
-w /etc/cron.hourly/    -p wa -k cron_changes
-w /etc/cron.daily/     -p wa -k cron_changes
-w /etc/cron.weekly/    -p wa -k cron_changes
-w /etc/cron.monthly/   -p wa -k cron_changes
-w /var/spool/cron/     -p wa -k cron_changes

# Network configuration
-w /etc/hosts           -p wa -k hosts_changes
-w /etc/resolv.conf     -p wa -k dns_changes

# Service / unit changes
-w /etc/systemd/system/ -p wa -k systemd_changes
-w /lib/systemd/system/ -p wa -k systemd_changes

# Container runtime configuration (not runtime state)
-w /etc/docker/daemon.json -p wa -k docker_config

{% if wazuh_agent_fim_extra_paths | default([]) | length > 0 %}
# Extra paths (wazuh_agent_fim_extra_paths)
{% for p in wazuh_agent_fim_extra_paths %}
-w {{ p }} -p wa -k extra_paths
{% endfor %}
{% endif %}
