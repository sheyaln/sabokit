---
# {{ ansible_managed }}
# Managed by sabokit apps/wazuh-agent/ansible/role.
# Do not edit by hand — regenerated on every ansible-playbook run.

services:
  wazuh-agent:
    image: "{{ wazuh_agent_image }}:{{ wazuh_agent_release_version }}"
    container_name: wazuh-agent
    restart: unless-stopped
    hostname: "{{ wazuh_agent_name }}"
    environment:
      WAZUH_MANAGER_SERVER: "{{ wazuh_agent_manager_address }}"
{% for key, value in (wazuh_agent_extra_env_vars | default({})).items() %}
      {{ key }}: "{{ value }}"
{% endfor %}
    # Host network — agent monitors host-level logs + needs to reach the
    # manager over the host's network interfaces.
    network_mode: host
    volumes:
      # Read-only access to host logs for filebeat/log monitoring.
      - /var/log:/var/log:ro
{% if wazuh_agent_fim_enabled | default(true) %}
      # Custom ossec.conf override — enables FIM (syscheck) + auditd ingest.
      # Wazuh agent image picks up /wazuh-config-mount/etc/ossec.conf on boot.
      - {{ wazuh_agent_install_dir }}/ossec.conf:/wazuh-config-mount/etc/ossec.conf:ro
      # Host's auditd writes here; agent tails audit.log inside the container.
      - /var/log/audit:/var/log/audit:ro
{% endif %}
    labels:
{% if wazuh_agent_diun_watch_enabled | default(true) %}
      - "diun.enable=true"
{% endif %}
{% if wazuh_agent_autoheal_enabled | default(false) %}
      - "autoheal=true"
{% endif %}
