---
# {{ ansible_managed }}
# Managed by sabokit bootstrap/protonmail-bridge/ansible/role.
# Do not edit by hand — regenerated on every ansible-playbook run.

services:
  protonmail-bridge:
    image: "{{ protonmail_bridge_image }}:{{ protonmail_bridge_image_tag }}"
    container_name: protonmail-bridge
    hostname: protonmail-bridge
    restart: unless-stopped
    environment:
      TZ: "{{ protonmail_bridge_timezone }}"
{% for key, value in (protonmail_bridge_extra_env_vars | default({})).items() %}
      {{ key }}: "{{ value }}"
{% endfor %}
    # Bridge data + login state. Manual `bridge --cli` login runs ON FIRST
    # DEPLOY (see README), and the credentials persist in this volume.
    volumes:
      - protonmail_data:/root
    expose:
      - "143"  # IMAP — SMTP is handled by Scaleway TEM at the base tier.
    networks:
      - "{{ protonmail_bridge_network }}"
    security_opt:
      - no-new-privileges:true
    healthcheck:
      test: ["CMD-SHELL", "nc -z localhost 143 || exit 1"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 120s
    deploy:
      resources:
        limits:
          memory: "{{ protonmail_bridge_memory_limit }}"
          cpus: "{{ protonmail_bridge_cpu_limit }}"
        reservations:
          memory: "{{ protonmail_bridge_memory_reservation }}"
          cpus: "{{ protonmail_bridge_cpu_reservation }}"
    labels:
{% if protonmail_bridge_diun_watch_enabled | default(false) %}
      - "diun.enable=true"
{% endif %}
{% if protonmail_bridge_autoheal_enabled | default(false) %}
      - "autoheal=true"
{% endif %}

volumes:
  protonmail_data:

networks:
  "{{ protonmail_bridge_network }}":
    external: true
