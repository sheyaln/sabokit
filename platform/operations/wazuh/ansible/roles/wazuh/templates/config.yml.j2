---
# {{ ansible_managed }}
# opensearch-security authentication config. Native OIDC against Authentik
# (dashboard delegates SSO to opensearch-security), with HTTP Basic against
# internal_users kept as fallback for the kibanaserver service account.

_meta:
  type: "config"
  config_version: 2

config:
  dynamic:
    http:
      anonymous_auth_enabled: false
    authc:
      oidc_auth_domain:
        description: "OIDC via Authentik"
        http_enabled: true
        transport_enabled: true
        order: 0
        http_authenticator:
          type: openid
          challenge: false
          config:
            subject_key: preferred_username
            roles_key: groups
            openid_connect_url: "{{ wazuh_app_secrets.OIDC_DISCOVERY_URL }}"
        authentication_backend:
          type: noop
      basic_internal_auth_domain:
        description: "HTTP Basic against the internal users database (kibanaserver + admin fallback)"
        http_enabled: true
        transport_enabled: true
        order: 1
        http_authenticator:
          type: basic
          challenge: false
        authentication_backend:
          type: intern
