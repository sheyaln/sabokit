#!/bin/bash
# {{ ansible_managed }}
# entrypoint-with-secrets <app-name> [command...]
#
# Container entrypoint wrapper. Fetches secrets into /run/secrets (tmpfs)
# before exec'ing the real command. App images should reference secrets via
# *_FILE env vars pointing at /run/secrets/<name>, e.g.:
#   DATABASE_PASSWORD_FILE=/run/secrets/db_password
#
# Compose usage:
#   entrypoint: ["{{ scw_secrets_bin_dir }}/entrypoint-with-secrets", "outline"]
#   command:    ["yarn", "start"]
#
# Environment knobs:
#   SCW_APP_NAME      override app name (default: $1)
#   SCW_SECRETS_DIR   override secrets dir (default: /run/secrets)
#   SCW_SKIP_SECRETS  set to "true" to skip fetching (for local dev)
#   SCW_EXPORT_SECRETS=true also exports each as UPPERCASE env var

set -euo pipefail

FETCH_SCRIPT="{{ scw_secrets_bin_dir }}/fetch-secrets"
DEFAULT_SECRETS_DIR="/run/secrets"

if [[ $# -lt 1 ]]; then
    echo "ERROR: Usage: entrypoint-with-secrets <app-name> [command...]" >&2
    exit 1
fi

APP_NAME="${SCW_APP_NAME:-$1}"
shift
COMMAND=("$@")

SECRETS_DIR="${SCW_SECRETS_DIR:-$DEFAULT_SECRETS_DIR}"

if [[ "${SCW_SKIP_SECRETS:-false}" == "true" ]]; then
    echo "[entrypoint] Skipping secret fetch (SCW_SKIP_SECRETS=true)"
    exec "${COMMAND[@]}"
fi

if [[ ! -d "$SECRETS_DIR" ]]; then
    echo "[entrypoint] Creating secrets directory: $SECRETS_DIR"
    mkdir -p "$SECRETS_DIR"
    chmod 0700 "$SECRETS_DIR"
fi

echo "[entrypoint] Fetching secrets for: $APP_NAME"

if ! sudo -u {{ scw_secrets_user }} "$FETCH_SCRIPT" "$APP_NAME" "$SECRETS_DIR"; then
    echo "ERROR: Failed to fetch secrets for $APP_NAME" >&2
    exit 1
fi

echo "[entrypoint] Secrets fetched successfully"

if [[ "${SCW_EXPORT_SECRETS:-false}" == "true" ]]; then
    echo "[entrypoint] Exporting secrets as environment variables"
    for secret_file in "$SECRETS_DIR"/*; do
        if [[ -f "$secret_file" ]]; then
            var_name=$(basename "$secret_file" | tr '[:lower:]' '[:upper:]' | tr '-' '_')
            export "$var_name"="$(cat "$secret_file")"
        fi
    done
fi

{% raw %}
if [[ ${#COMMAND[@]} -eq 0 ]]; then
    echo "ERROR: No command specified" >&2
    exit 1
fi

echo "[entrypoint] Starting: ${COMMAND[*]}"
exec "${COMMAND[@]}"
{% endraw %}
