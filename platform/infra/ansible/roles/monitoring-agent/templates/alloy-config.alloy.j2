// {{ ansible_managed }}
// Grafana Alloy configuration. Ships docker + system logs to a central Loki and
// remote_writes host + container metrics to a central Prometheus. Every host
// runs this agent and PUSHES — the central stack is never given a scrape port
// into the app/identity hosts (only the ops host accepts the push, in-VPC).

{% if monitoring_loki_push_url | length > 0 %}
loki.write "central_loki" {
  endpoint {
    url = env("LOKI_PUSH_URL")
  }
}
{% endif %}

{% if monitoring_prometheus_remote_write_url | length > 0 %}
// ── Metrics → central Prometheus (remote_write) ──────────────────────────────
prometheus.remote_write "central" {
  endpoint {
    url = env("PROMETHEUS_REMOTE_WRITE_URL")
  }
  external_labels = {
    host        = "{{ monitoring_host_label }}",
    environment = "{{ monitoring_environment }}",
  }
}

// Local exporters, reached by container name over the shared docker network —
// no host-published port, so nothing outside this host can scrape them.
prometheus.scrape "node" {
  targets         = [{"__address__" = "node-exporter:9100", "job" = "node", "instance" = "{{ monitoring_host_label }}"}]
  forward_to      = [prometheus.remote_write.central.receiver]
  scrape_interval = "30s"
}

prometheus.scrape "cadvisor" {
  targets         = [{"__address__" = "cadvisor:8080", "job" = "cadvisor", "instance" = "{{ monitoring_host_label }}"}]
  forward_to      = [prometheus.remote_write.central.receiver]
  scrape_interval = "30s"
}

// App-exported metrics are opt-in: a container labels itself
// `sabokit.metrics.port=<port>` (optional `sabokit.metrics.path`, default
// /metrics) and Alloy discovers + scrapes it on the shared network. cadvisor
// already covers per-container resource metrics, so this is only for
// application-level metrics a bundle chooses to expose.
discovery.docker "app_metrics" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "30s"
  filter {
    name   = "label"
    values = ["sabokit.metrics.port"]
  }
}

discovery.relabel "app_metrics" {
  targets = discovery.docker.app_metrics.targets

  // job + base address from the container name (strip the leading slash).
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "job"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "__address__"
  }
  // Append the labelled port → "<container>:<port>".
  rule {
    source_labels = ["__address__", "__meta_docker_container_label_sabokit_metrics_port"]
    separator     = ":"
    target_label  = "__address__"
  }
  rule {
    source_labels = ["__meta_docker_container_label_sabokit_metrics_path"]
    regex         = "(.+)"
    target_label  = "__metrics_path__"
  }
  rule {
    target_label = "instance"
    replacement  = "{{ monitoring_host_label }}"
  }
}

prometheus.scrape "app_metrics" {
  targets         = discovery.relabel.app_metrics.output
  forward_to      = [prometheus.remote_write.central.receiver]
  scrape_interval = "30s"
}
{% endif %}

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "30s"
}

discovery.relabel "docker_containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_log_path"]
    target_label  = "__path__"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container_name"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project_name"
  }

  rule {
    target_label = "host"
    replacement  = "{{ monitoring_host_label }}"
  }

  rule {
    target_label = "environment"
    replacement  = "{{ monitoring_environment }}"
  }

  rule {
    target_label = "log_type"
    replacement  = "application"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker_containers.output
{% if monitoring_loki_push_url | length > 0 %}
  forward_to = [loki.process.docker_logs.receiver]
{% else %}
  forward_to = []
{% endif %}
}

{% if monitoring_loki_push_url | length > 0 %}
loki.process "docker_logs" {
  forward_to = [loki.write.central_loki.receiver]

  // Drop successful Traefik access logs (2xx/3xx) to keep Loki cardinality
  // and storage in check. Errors and 4xx/5xx still ship.
  stage.match {
    selector = "{service_name=\"traefik\"}"

    stage.json {
      expressions = {
        status = "status",
      }
    }

    stage.match {
      selector = "{service_name=\"traefik\"} |~ \"status.*[23][0-9][0-9]\""
      action   = "drop"
      drop_counter_reason = "traefik_success_logs"
    }
  }

  // Drop high-cardinality labels.
  stage.label_drop {
    values = ["container_id", "image_id", "stream", "compose_config_sha"]
  }
}
{% endif %}

local.file_match "system_logs" {
  path_targets = [
    {
      __path__    = "/var/log/syslog",
      log_type    = "system",
      host        = "{{ monitoring_host_label }}",
      environment = "{{ monitoring_environment }}",
    },
    {
      __path__    = "/var/log/auth.log",
      log_type    = "auth",
      host        = "{{ monitoring_host_label }}",
      environment = "{{ monitoring_environment }}",
    },
  ]
}

loki.source.file "system_logs" {
  targets    = local.file_match.system_logs.targets
{% if monitoring_loki_push_url | length > 0 %}
  forward_to = [loki.process.system_logs.receiver]
{% else %}
  forward_to = []
{% endif %}
}

{% if monitoring_loki_push_url | length > 0 %}
loki.process "system_logs" {
  forward_to = [loki.write.central_loki.receiver]

  stage.regex {
    expression = "^(?P<ts>\\w{3}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2})\\s+(?P<host_field>\\S+)\\s+(?P<service>[^:\\[]+)"
  }

  stage.labels {
    values = {
      service = "",
    }
  }
}
{% endif %}
