# {{ ansible_managed }}
# Vikunja environment — DO NOT EDIT MANUALLY.
# Regenerated on every ansible-playbook run from Scaleway Secret Manager.

TZ={{ vikunja_timezone }}
VIKUNJA_SERVICE_TIMEZONE={{ vikunja_timezone }}
VIKUNJA_SERVICE_PUBLICURL=https://{{ vikunja_hostname }}
VIKUNJA_SERVICE_JWTSECRET={{ vikunja_app_secrets.VIKUNJA_SERVICE_JWTSECRET }}

VIKUNJA_SERVICE_ENABLEREGISTRATION={{ vikunja_enable_registration | lower }}
VIKUNJA_AUTH_LOCAL_ENABLED={{ vikunja_enable_local_auth | lower }}
{% if vikunja_default_week_start is not none %}
VIKUNJA_DEFAULTSETTINGS_WEEK_START={{ vikunja_default_week_start }}
{% endif %}

# ── Database (PostgreSQL) ──
VIKUNJA_DATABASE_TYPE=postgres
VIKUNJA_DATABASE_HOST={{ vikunja_db_credentials.host }}:{{ vikunja_db_credentials.port }}
VIKUNJA_DATABASE_DATABASE={{ vikunja_db_credentials.dbname }}
VIKUNJA_DATABASE_USER={{ vikunja_db_credentials.username }}
VIKUNJA_DATABASE_PASSWORD={{ vikunja_db_credentials.password | replace('$', '$$') }}
VIKUNJA_DATABASE_SSLMODE=disable

# ── OIDC (Authentik) ──
VIKUNJA_AUTH_OPENID_ENABLED=true
VIKUNJA_AUTH_OPENID_REDIRECTURL=https://{{ vikunja_hostname }}/auth/openid/authentik
VIKUNJA_AUTH_OPENID_PROVIDERS_AUTHENTIK_NAME=Authentik
VIKUNJA_AUTH_OPENID_PROVIDERS_AUTHENTIK_AUTHURL={{ vikunja_app_secrets.VIKUNJA_AUTH_OPENID_AUTHURL }}
VIKUNJA_AUTH_OPENID_PROVIDERS_AUTHENTIK_LOGOUTURL={{ vikunja_app_secrets.VIKUNJA_AUTH_OPENID_LOGOUTURL }}
VIKUNJA_AUTH_OPENID_PROVIDERS_AUTHENTIK_CLIENTID={{ vikunja_app_secrets.VIKUNJA_AUTH_OPENID_CLIENTID }}
VIKUNJA_AUTH_OPENID_PROVIDERS_AUTHENTIK_CLIENTSECRET={{ vikunja_app_secrets.VIKUNJA_AUTH_OPENID_CLIENTSECRET }}
VIKUNJA_AUTH_OPENID_PROVIDERS_AUTHENTIK_SCOPE=openid profile email {{ vikunja_oidc_groups_scope_name | default('vikunja_scope') }}

{% if vikunja_smtp_config and vikunja_smtp_config | length > 0 and vikunja_app_secrets.VIKUNJA_MAILER_FROMEMAIL | length > 0 %}
# ── SMTP ──
VIKUNJA_MAILER_ENABLED=true
VIKUNJA_MAILER_HOST={{ vikunja_smtp_config.host }}
VIKUNJA_MAILER_PORT={{ vikunja_smtp_config.port }}
VIKUNJA_MAILER_USERNAME={{ vikunja_smtp_config.username }}
VIKUNJA_MAILER_PASSWORD={{ vikunja_smtp_config.password }}
VIKUNJA_MAILER_FROMEMAIL={{ vikunja_app_secrets.VIKUNJA_MAILER_FROMEMAIL }}
VIKUNJA_MAILER_SKIPTLSVERIFY=false
{% else %}
VIKUNJA_MAILER_ENABLED=false
{% endif %}

# ── Consumer-supplied extra env vars ──
{% for key, value in (vikunja_extra_env_vars | default({})).items() %}
{{ key }}={{ value }}
{% endfor %}
