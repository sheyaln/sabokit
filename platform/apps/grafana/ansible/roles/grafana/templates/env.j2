# {{ ansible_managed }}
# Grafana environment — DO NOT EDIT MANUALLY.

GF_SERVER_ROOT_URL=https://{{ grafana_hostname }}
GF_SERVER_DOMAIN={{ grafana_hostname }}

{% if grafana_plugins | length > 0 %}
GF_PLUGINS_PREINSTALL={{ grafana_plugins | join(',') }}
{% endif %}

GF_LOG_MODE=console
GF_LOG_LEVEL=info

GF_AUTH_ANONYMOUS_ENABLED=false

# Bootstrap admin (set once on first boot; afterwards admin password can be
# rotated via grafana-cli or the API).
GF_SECURITY_ADMIN_USER={{ grafana_app_secrets.GRAFANA_ADMIN_USER }}
GF_SECURITY_ADMIN_PASSWORD={{ grafana_app_secrets.GRAFANA_ADMIN_PASSWORD | replace('$', '$$') }}

# OIDC (Authentik)
GF_AUTH_GENERIC_OAUTH_ENABLED=true
GF_AUTH_GENERIC_OAUTH_NAME=Authentik
GF_AUTH_GENERIC_OAUTH_CLIENT_ID={{ grafana_app_secrets.OIDC_CLIENT_ID }}
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET={{ grafana_app_secrets.OIDC_CLIENT_SECRET | replace('$', '$$') }}
GF_AUTH_GENERIC_OAUTH_SCOPES=openid profile email offline_access groups
GF_AUTH_GENERIC_OAUTH_AUTH_URL={{ grafana_app_secrets.OIDC_AUTH_URL }}
GF_AUTH_GENERIC_OAUTH_TOKEN_URL={{ grafana_app_secrets.OIDC_TOKEN_URL }}
GF_AUTH_GENERIC_OAUTH_API_URL={{ grafana_app_secrets.OIDC_API_URL }}
GF_AUTH_GENERIC_OAUTH_SIGNOUT_REDIRECT_URL={{ grafana_app_secrets.OIDC_SIGNOUT_URL }}
GF_AUTH_GENERIC_OAUTH_EMAIL_ATTRIBUTE_PATH=email
GF_AUTH_GENERIC_OAUTH_NAME_ATTRIBUTE_PATH=name
GF_AUTH_GENERIC_OAUTH_LOGIN_ATTRIBUTE_PATH=preferred_username
GF_AUTH_GENERIC_OAUTH_USE_PKCE=true
GF_AUTH_GENERIC_OAUTH_USE_REFRESH_TOKEN=true
GF_AUTH_GENERIC_OAUTH_ALLOW_SIGN_UP=true
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_STRICT=true
GF_AUTH_GENERIC_OAUTH_GROUPS_ATTRIBUTE_PATH=groups
# Map Authentik group → Grafana role. Admin > Editor > Viewer.
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH=contains(groups[*], '{{ grafana_oidc_admin_group }}') && 'Admin' || contains(groups[*], '{{ grafana_oidc_editor_group }}') && 'Editor' || 'Viewer'

# ── Consumer-supplied extra env vars ──
{% for key, value in (grafana_extra_env_vars | default({})).items() %}
{{ key }}={{ value }}
{% endfor %}
