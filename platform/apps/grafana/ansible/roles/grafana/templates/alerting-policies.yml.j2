# {{ ansible_managed }}
# Grafana notification policies. Provisioned via the alerting file provider.
# Root policy routes to jsm-default when JSM is configured; otherwise this
# file is not rendered and Grafana keeps its built-in default contact point.
apiVersion: 1

policies:
  - orgId: 1
    receiver: jsm-default
    group_by:
      - grafana_folder
      - alertname
    group_wait: 30s
    group_interval: 5m
    repeat_interval: 4h
