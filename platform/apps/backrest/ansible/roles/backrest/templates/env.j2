# {{ ansible_managed }}
# Backrest environment — DO NOT EDIT MANUALLY.
# Regenerated on every ansible-playbook run from Scaleway Secret Manager.

BACKREST_PORT=9898
BACKREST_DATA=/data
BACKREST_CONFIG=/config/config.json
XDG_CACHE_HOME=/cache
TZ={{ backrest_timezone }}

# S3 credentials are also embedded in config.json's repo env block, but
# restic will read them from the container environment first. Keeping both
# in sync because Backrest's UI shells out with the container env for
# ad-hoc commands.
AWS_ACCESS_KEY_ID={{ backrest_app_secrets.AWS_ACCESS_KEY_ID }}
AWS_SECRET_ACCESS_KEY={{ backrest_app_secrets.AWS_SECRET_ACCESS_KEY }}
