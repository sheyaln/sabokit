# {{ ansible_managed }}
# n8n environment — DO NOT EDIT MANUALLY.
# Regenerated on every ansible-playbook run from Scaleway Secret Manager.

# ── Core ──
N8N_HOST={{ n8n_hostname }}
N8N_PROTOCOL=https
N8N_PORT=5678
WEBHOOK_URL={{ n8n_app_secrets.WEBHOOK_URL }}
GENERIC_TIMEZONE={{ n8n_timezone }}
TZ={{ n8n_timezone }}

# Credential encryption key — losing this means every saved credential in
# the database becomes unrecoverable. Locked by Terraform's ignore_changes.
N8N_ENCRYPTION_KEY={{ n8n_app_secrets.N8N_ENCRYPTION_KEY }}

# ── Behind Traefik ──
# n8n needs to trust the proxy headers for the editor URL + webhook callbacks
# to come back with the right scheme/host. N8N_PROXY_HOPS=1 = one proxy hop
# (Traefik). N8N_SECURE_COOKIE=false because Traefik terminates TLS.
N8N_SECURE_COOKIE=false
N8N_PROXY_HOPS=1
N8N_TRUST_PROXY=true

# ── OIDC (via hooks.js external hook) ──
EXTERNAL_HOOK_FILES=/home/node/.n8n/hooks.js
EXTERNAL_FRONTEND_HOOKS_URLS=/assets/oidc-frontend-hook.js
# /auth/* routes are served by hooks.js; n8n's UI router would otherwise
# intercept them and return the SPA shell.
N8N_ADDITIONAL_NON_UI_ROUTES=auth
OIDC_ISSUER_URL={{ n8n_app_secrets.OIDC_ISSUER_URL }}
OIDC_CLIENT_ID={{ n8n_app_secrets.OIDC_CLIENT_ID }}
OIDC_CLIENT_SECRET={{ n8n_app_secrets.OIDC_CLIENT_SECRET }}
OIDC_REDIRECT_URI={{ n8n_app_secrets.OIDC_REDIRECT_URI }}
OIDC_ADMIN_GROUP={{ n8n_app_secrets.OIDC_ADMIN_GROUP }}

# ── Database (PostgreSQL) ──
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST={{ n8n_db_credentials.host }}
DB_POSTGRESDB_PORT={{ n8n_db_credentials.port }}
DB_POSTGRESDB_DATABASE={{ n8n_db_credentials.dbname }}
DB_POSTGRESDB_USER={{ n8n_db_credentials.username }}
DB_POSTGRESDB_PASSWORD={{ n8n_db_credentials.password }}
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false

# ── Public REST API ──
N8N_PUBLIC_API_DISABLED={{ n8n_public_api_disabled | lower }}

# ── Metrics + diagnostics ──
N8N_METRICS={{ n8n_metrics_enabled | lower }}
N8N_DIAGNOSTICS_ENABLED=false

# ── Workflows can read container env vars ──
# Off by default upstream; flip on so Code-node and Set-node workflows can
# pull non-secret config (e.g. a global SMTP_FROM) without round-tripping
# through n8n's credential store.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# ── External task runner sidecar (Python + JavaScript) ──
# Shared secret with the n8n-runners container.
N8N_RUNNERS_ENABLED=true
N8N_RUNNERS_MODE=external
N8N_RUNNERS_BROKER_LISTEN_ADDRESS=0.0.0.0
N8N_RUNNERS_AUTH_TOKEN={{ n8n_app_secrets.N8N_RUNNERS_AUTH_TOKEN }}
N8N_NATIVE_PYTHON_RUNNER=true
