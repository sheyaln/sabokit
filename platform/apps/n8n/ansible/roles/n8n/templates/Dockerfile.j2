# {{ ansible_managed }}
# Custom n8n image — only built when n8n_build_from_source = true.
# Layers python3 + pip on top of the upstream image so the Execute Command
# node can shell out to python and run installed packages. The upstream
# image is a hardened Alpine with no package manager available at runtime;
# this is the documented way to add system tooling.
#
# If you don't need python in workflows, leave n8n_build_from_source = false
# and the pure upstream image is pulled instead — faster, simpler, no rebuild
# on every n8n bump.

FROM docker.n8n.io/n8nio/n8n:{{ n8n_image_tag }}

USER root

RUN apk add --no-cache python3 py3-pip

USER node
