# {{ ansible_managed }}
# Decidim environment — DO NOT EDIT MANUALLY.
# Regenerated on every ansible-playbook run from Scaleway Secret Manager.

RAILS_ENV=production
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true
LOG_LEVEL=info
PORT=3000
FORCE_SSL=yes

SECRET_KEY_BASE={{ decidim_app_secrets.SECRET_KEY_BASE }}

# ── URLs ──
DECIDIM_HOST={{ decidim_hostname }}
DECIDIM_APP_URL={{ decidim_app_secrets.DECIDIM_APP_URL }}

# ── Database (PostgreSQL) ──
DATABASE_URL=postgres://{{ decidim_db_credentials.username }}:{{ decidim_db_credentials.password | replace('$', '$$') }}@{{ decidim_db_credentials.host }}:{{ decidim_db_credentials.port }}/{{ decidim_db_credentials.dbname }}
POSTGRES_HOST={{ decidim_db_credentials.host }}
POSTGRES_PORT={{ decidim_db_credentials.port }}
POSTGRES_USER={{ decidim_db_credentials.username }}
POSTGRES_PASSWORD={{ decidim_db_credentials.password | replace('$', '$$') }}
POSTGRES_DB={{ decidim_db_credentials.dbname }}
PGSSLMODE=disable

# ── Redis ──
REDIS_URL=redis://decidim-redis:6379/0
QUEUE_ADAPTER=sidekiq

# ── Memcached (Rails fragment cache) ──
MEMCACHED_HOST=decidim-memcached

# ── OIDC (Authentik via decidim-omniauth-oauth2) ──
OIDC_CLIENT_ID={{ decidim_app_secrets.OIDC_CLIENT_ID }}
OIDC_CLIENT_SECRET={{ decidim_app_secrets.OIDC_CLIENT_SECRET }}
OIDC_AUTH_URI={{ decidim_app_secrets.OIDC_AUTH_URI }}
OIDC_TOKEN_URI={{ decidim_app_secrets.OIDC_TOKEN_URI }}
OIDC_USERINFO_URI={{ decidim_app_secrets.OIDC_USERINFO_URI }}
OIDC_LOGOUT_URI={{ decidim_app_secrets.OIDC_LOGOUT_URI }}
OIDC_ISSUER_URL={{ decidim_app_secrets.OIDC_ISSUER_URL }}
OIDC_SCOPES={{ decidim_app_secrets.OIDC_SCOPES }}

# ── S3 (uploads) ──
STORAGE_PROVIDER=s3
AWS_REGION={{ decidim_app_secrets.AWS_REGION }}
AWS_S3_ENDPOINT={{ decidim_app_secrets.AWS_S3_ENDPOINT }}
AWS_S3_BUCKET={{ decidim_app_secrets.AWS_S3_BUCKET }}
AWS_S3_FORCE_PATH_STYLE={{ decidim_app_secrets.AWS_S3_FORCE_PATH_STYLE }}
AWS_ACCESS_KEY_ID={{ decidim_app_secrets.AWS_ACCESS_KEY_ID }}
AWS_SECRET_ACCESS_KEY={{ decidim_app_secrets.AWS_SECRET_ACCESS_KEY }}
AWS_S3_ACL={{ decidim_app_secrets.AWS_S3_ACL }}
UPLOAD_MAX_SIZE_BYTES={{ decidim_app_secrets.UPLOAD_MAX_SIZE_BYTES }}

# ── /system superuser (bootstrap only) ──
DECIDIM_SYSTEM_EMAIL={{ decidim_app_secrets.DECIDIM_SYSTEM_EMAIL }}
DECIDIM_SYSTEM_PASSWORD={{ decidim_app_secrets.DECIDIM_SYSTEM_PASSWORD | replace('$', '$$') }}

# ── First organization (auto-created on first deploy) ──
DECIDIM_ORG_NAME={{ decidim_app_secrets.DECIDIM_ORG_NAME }}
DECIDIM_ORG_REFERENCE_PREFIX={{ decidim_app_secrets.DECIDIM_ORG_REFERENCE_PREFIX }}
DECIDIM_DEFAULT_LOCALE={{ decidim_app_secrets.DECIDIM_DEFAULT_LOCALE }}
DECIDIM_AVAILABLE_LOCALES={{ decidim_app_secrets.DECIDIM_AVAILABLE_LOCALES }}
DECIDIM_ORG_ADMIN_EMAIL={{ decidim_app_secrets.DECIDIM_ORG_ADMIN_EMAIL }}
DECIDIM_ORG_ADMIN_PASSWORD={{ decidim_app_secrets.DECIDIM_ORG_ADMIN_PASSWORD | replace('$', '$$') }}

{% if decidim_smtp_config and decidim_smtp_config | length > 0 and decidim_app_secrets.SMTP_FROM_EMAIL | length > 0 %}
# ── SMTP ──
SMTP_FROM_EMAIL={{ decidim_app_secrets.SMTP_FROM_EMAIL }}
SMTP_ADDRESS={{ decidim_smtp_config.host }}
SMTP_PORT={{ decidim_smtp_config.port }}
SMTP_USERNAME={{ decidim_smtp_config.username }}
SMTP_PASSWORD={{ decidim_smtp_config.password }}
SMTP_DOMAIN={{ decidim_smtp_config.domain | default(decidim_hostname) }}
SMTP_AUTHENTICATION={{ decidim_smtp_config.authentication | default('login') }}
{% endif %}
