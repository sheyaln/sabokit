# {{ ansible_managed }}
# Steward environment — DO NOT EDIT MANUALLY.
# Regenerated on every ansible-playbook run from Scaleway Secret Manager.

# ── Django ──
DJANGO_SECRET_KEY={{ steward_app_secrets.DJANGO_SECRET_KEY }}
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS={{ steward_app_secrets.DJANGO_ALLOWED_HOSTS }}

# ── Database ──
DATABASE_URL=postgres://{{ steward_db_credentials.username }}:{{ steward_db_credentials.password | replace('$', '$$') }}@{{ steward_db_credentials.host }}:{{ steward_db_credentials.port }}/{{ steward_db_credentials.dbname }}

# ── OIDC (Authentik) ──
OIDC_RP_CLIENT_ID={{ steward_app_secrets.OIDC_RP_CLIENT_ID }}
OIDC_RP_CLIENT_SECRET={{ steward_app_secrets.OIDC_RP_CLIENT_SECRET }}
OIDC_OP_AUTHORIZATION_ENDPOINT={{ steward_app_secrets.OIDC_OP_AUTHORIZATION_ENDPOINT }}
OIDC_OP_TOKEN_ENDPOINT={{ steward_app_secrets.OIDC_OP_TOKEN_ENDPOINT }}
OIDC_OP_USER_ENDPOINT={{ steward_app_secrets.OIDC_OP_USER_ENDPOINT }}
OIDC_OP_JWKS_ENDPOINT={{ steward_app_secrets.OIDC_OP_JWKS_ENDPOINT }}
OIDC_RP_SIGN_ALGO={{ steward_app_secrets.OIDC_RP_SIGN_ALGO }}
OIDC_RP_SCOPES={{ steward_app_secrets.OIDC_RP_SCOPES }}
OIDC_VERIFY_SSL=true

# ── Authentik admin API ──
AUTHENTIK_API_URL={{ steward_app_secrets.AUTHENTIK_API_URL }}
AUTHENTIK_API_TOKEN={{ steward_app_secrets.AUTHENTIK_API_TOKEN }}
AUTHENTIK_ADMIN_GROUP={{ steward_app_secrets.AUTHENTIK_ADMIN_GROUP }}
AUTHENTIK_INVITE_FLOW={{ steward_app_secrets.AUTHENTIK_INVITE_FLOW | default('') }}
