# {{ ansible_managed }}
# Postiz environment — DO NOT EDIT MANUALLY.
# Regenerated on every ansible-playbook run from Scaleway Secret Manager.

# ── Required ──
MAIN_URL={{ postiz_app_secrets.MAIN_URL }}
FRONTEND_URL={{ postiz_app_secrets.FRONTEND_URL }}
NEXT_PUBLIC_BACKEND_URL={{ postiz_app_secrets.NEXT_PUBLIC_BACKEND_URL }}
BACKEND_INTERNAL_URL={{ postiz_app_secrets.BACKEND_INTERNAL_URL }}
JWT_SECRET={{ postiz_app_secrets.JWT_SECRET }}

DATABASE_URL=postgresql://{{ postiz_db_credentials.username }}:{{ postiz_db_credentials.password | replace('$', '$$') }}@{{ postiz_db_credentials.host }}:{{ postiz_db_credentials.port }}/{{ postiz_db_credentials.dbname }}

REDIS_URL=redis://postiz-redis:6379
TEMPORAL_ADDRESS=temporal:7233

IS_GENERAL=true
DISABLE_REGISTRATION={{ postiz_disable_registration | string | lower }}
TZ={{ postiz_timezone }}

# ── Storage (local filesystem only for v1; future S3 support pending upstream PR #1124) ──
STORAGE_PROVIDER=local
UPLOAD_DIRECTORY={{ postiz_uploads_dir }}
NEXT_PUBLIC_UPLOAD_DIRECTORY={{ postiz_uploads_dir }}

# ── OIDC (Authentik) ──
POSTIZ_GENERIC_OAUTH={{ postiz_app_secrets.POSTIZ_GENERIC_OAUTH }}
POSTIZ_OAUTH_URL={{ postiz_app_secrets.POSTIZ_OAUTH_URL }}
POSTIZ_OAUTH_AUTH_URL={{ postiz_app_secrets.POSTIZ_OAUTH_AUTH_URL }}
POSTIZ_OAUTH_TOKEN_URL={{ postiz_app_secrets.POSTIZ_OAUTH_TOKEN_URL }}
POSTIZ_OAUTH_USERINFO_URL={{ postiz_app_secrets.POSTIZ_OAUTH_USERINFO_URL }}
POSTIZ_OAUTH_CLIENT_ID={{ postiz_app_secrets.POSTIZ_OAUTH_CLIENT_ID }}
POSTIZ_OAUTH_CLIENT_SECRET={{ postiz_app_secrets.POSTIZ_OAUTH_CLIENT_SECRET }}
POSTIZ_OAUTH_SCOPE={{ postiz_app_secrets.POSTIZ_OAUTH_SCOPE }}
NEXT_PUBLIC_POSTIZ_OAUTH_DISPLAY_NAME={{ postiz_app_secrets.NEXT_PUBLIC_POSTIZ_OAUTH_DISPLAY_NAME }}

{% if postiz_smtp_config and postiz_smtp_config | length > 0 and postiz_app_secrets.EMAIL_FROM_ADDRESS | length > 0 %}
# ── SMTP ──
EMAIL_FROM_ADDRESS={{ postiz_app_secrets.EMAIL_FROM_ADDRESS }}
EMAIL_HOST={{ postiz_smtp_config.host }}
EMAIL_PORT={{ postiz_smtp_config.port }}
EMAIL_USER={{ postiz_smtp_config.username }}
EMAIL_PASS={{ postiz_smtp_config.password }}
EMAIL_SECURE={{ postiz_smtp_config.use_tls | default('true') }}
{% endif %}

# ── Social platform OAuth (set per platform from social_platform_credentials TF input) ──
# Each entry below is emitted only when the consumer supplied a value via
# var.social_platform_credentials. Postiz omits the platform from its connect
# list when the key is absent or empty.
{% set _social_keys = [
  'X_URL', 'X_API_KEY', 'X_API_SECRET',
  'LINKEDIN_CLIENT_ID', 'LINKEDIN_CLIENT_SECRET',
  'REDDIT_CLIENT_ID', 'REDDIT_CLIENT_SECRET',
  'GITHUB_CLIENT_ID', 'GITHUB_CLIENT_SECRET',
  'BEEHIIVE_API_KEY', 'BEEHIIVE_PUBLICATION_ID',
  'THREADS_APP_ID', 'THREADS_APP_SECRET',
  'FACEBOOK_APP_ID', 'FACEBOOK_APP_SECRET',
  'YOUTUBE_CLIENT_ID', 'YOUTUBE_CLIENT_SECRET',
  'TIKTOK_CLIENT_ID', 'TIKTOK_CLIENT_SECRET',
  'PINTEREST_CLIENT_ID', 'PINTEREST_CLIENT_SECRET',
  'DRIBBBLE_CLIENT_ID', 'DRIBBBLE_CLIENT_SECRET',
  'DISCORD_CLIENT_ID', 'DISCORD_CLIENT_SECRET', 'DISCORD_BOT_TOKEN_ID',
  'SLACK_ID', 'SLACK_SECRET', 'SLACK_SIGNING_SECRET',
  'MASTODON_URL', 'MASTODON_CLIENT_ID', 'MASTODON_CLIENT_SECRET',
] %}
{% for key in _social_keys %}
{% if key in postiz_app_secrets and postiz_app_secrets[key] | length > 0 %}
{{ key }}={{ postiz_app_secrets[key] }}
{% endif %}
{% endfor %}

# ── Misc Postiz settings (defaults match upstream docker-compose) ──
API_LIMIT=30
FEE_AMOUNT=0.05
NX_ADD_PLUGINS=false
