# Managed by sabokit apps/postiz/ansible/role.
# Do not edit by hand — regenerated on every ansible-playbook run.
#
# Heavy stack: postiz + redis + temporal + temporal-postgres + elasticsearch.
# Total resident set ~3GB once warmed. The postiz container itself listens on
# :5000 (NextJS); :3000 is the internal NestJS API the same image runs.

services:
  postiz:
    image: "{{ postiz_image }}:{{ postiz_image_tag }}"
    container_name: postiz
    restart: always
    env_file:
      - .env
    volumes:
      - postiz-config:/config/
      - postiz-uploads:/uploads/
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network={{ postiz_traefik_docker_network }}"
      - "traefik.http.services.postiz.loadbalancer.server.port=5000"
      - "traefik.http.routers.postiz.rule=Host(`{{ postiz_hostname }}`)"
      - "traefik.http.routers.postiz.entrypoints=websecure"
      - "traefik.http.routers.postiz.tls.certresolver=le"
      - "traefik.http.routers.postiz.service=postiz"
{% if postiz_auto_update_enabled | default(false) %}
      - "com.centurylinklabs.watchtower.enable=true"
{% endif %}
{% if postiz_autoheal_enabled | default(false) %}
      - "autoheal=true"
{% endif %}
    networks:
      - "{{ postiz_traefik_docker_network }}"
      - postiz-network
      - temporal-network
    depends_on:
      postiz-redis:
        condition: service_healthy
      temporal:
        condition: service_started
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          memory: "{{ postiz_memory_limit }}"
          cpus: "{{ postiz_cpu_limit }}"
        reservations:
          memory: "{{ postiz_memory_reservation }}"
          cpus: "{{ postiz_cpu_reservation }}"
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:5000/ >/dev/null 2>&1 || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 120s

  postiz-redis:
    image: redis:7.2
    container_name: postiz-redis
    restart: always
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 3
    volumes:
      - postiz-redis-data:/data
    networks:
      - postiz-network
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          memory: "{{ postiz_redis_memory_limit }}"

  # ── Temporal stack (workflow orchestration; required by Postiz) ──────────
  # Temporal's metadata DB stays in-stack — it's a workflow log, not user
  # data, and not worth fighting Scaleway RDB's lifecycle for.
  temporal-postgres:
    image: "postgres:{{ postiz_temporal_postgres_image_tag }}"
    container_name: temporal-postgres
    restart: always
    environment:
      POSTGRES_USER: "{{ postiz_app_secrets.TEMPORAL_POSTGRES_USER }}"
      POSTGRES_PASSWORD: "{{ postiz_app_secrets.TEMPORAL_POSTGRES_PASSWORD }}"
    volumes:
      - temporal-postgres-data:/var/lib/postgresql/data
    networks:
      - temporal-network
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          memory: "{{ postiz_temporal_pg_memory_limit }}"

  temporal-elasticsearch:
    image: "elasticsearch:{{ postiz_temporal_elasticsearch_image_tag }}"
    container_name: temporal-elasticsearch
    restart: always
    environment:
      - cluster.routing.allocation.disk.threshold_enabled=true
      - cluster.routing.allocation.disk.watermark.low=512mb
      - cluster.routing.allocation.disk.watermark.high=256mb
      - cluster.routing.allocation.disk.watermark.flood_stage=128mb
      - discovery.type=single-node
      - "ES_JAVA_OPTS=-Xms{{ postiz_es_heap_size }} -Xmx{{ postiz_es_heap_size }}"
      - xpack.security.enabled=false
    volumes:
      - temporal-elasticsearch-data:/usr/share/elasticsearch/data
    networks:
      - temporal-network
    deploy:
      resources:
        limits:
          memory: "{{ postiz_es_memory_limit }}"

  temporal:
    image: "temporalio/auto-setup:{{ postiz_temporal_image_tag }}"
    container_name: temporal
    restart: always
    depends_on:
      - temporal-postgres
      - temporal-elasticsearch
    environment:
      - DB=postgres12
      - DB_PORT=5432
      - POSTGRES_USER={{ postiz_app_secrets.TEMPORAL_POSTGRES_USER }}
      - POSTGRES_PWD={{ postiz_app_secrets.TEMPORAL_POSTGRES_PASSWORD }}
      - POSTGRES_SEEDS=temporal-postgres
      - ENABLE_ES=true
      - ES_SEEDS=temporal-elasticsearch
      - ES_VERSION=v7
      - TEMPORAL_NAMESPACE=default
    networks:
      - temporal-network
    deploy:
      resources:
        limits:
          memory: "{{ postiz_temporal_memory_limit }}"

volumes:
  postiz-config:
  postiz-uploads:
  postiz-redis-data:
  temporal-postgres-data:
  temporal-elasticsearch-data:

networks:
  postiz-network:
    driver: bridge
  temporal-network:
    driver: bridge
  "{{ postiz_traefik_docker_network }}":
    external: true
