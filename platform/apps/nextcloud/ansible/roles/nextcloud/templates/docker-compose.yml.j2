---
# Managed by sabokit apps/nextcloud/ansible/role.
# Do not edit by hand — regenerated on every ansible-playbook run.

services:
  nextcloud-redis:
    image: redis:7-alpine
    container_name: nextcloud-redis
    restart: always
    command: redis-server --requirepass ${REDIS_PASSWORD}
    volumes:
      - redis-data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "-a", "${REDIS_PASSWORD}", "ping"]
      interval: 10s
      timeout: 3s
      retries: 3
    networks:
      - nextcloud_network
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          memory: 256M
          cpus: '0.25'
        reservations:
          memory: 64M
          cpus: '0.1'

  nextcloud-app:
    image: "{{ nextcloud_image }}:{{ nextcloud_image_tag }}"
    container_name: nextcloud-app
    restart: always
    depends_on:
      - nextcloud-redis
    env_file:
      - .env
    environment:
      # Apache body limit must match the FILE_STORAGE_UPLOAD_MAX_SIZE in env.j2.
      APACHE_BODY_LIMIT: "{{ nextcloud_apache_body_limit }}"
      # Fontconfig cache: the apache image's www-data user can't write to the
      # default /var/cache/fontconfig under SELinux/strict-mode kernels, so
      # redirect to a path we own.
      FONTCONFIG_PATH: /var/www/.cache/fontconfig
      XDG_CACHE_HOME: /var/www/.cache
      TZ: "{{ nextcloud_timezone }}"
    volumes:
      - nextcloud-data:/var/www/html
      - nextcloud-fontcache:/var/cache/fontconfig
      - nextcloud-wwwcache:/var/www/.cache
      - ./nextcloud-custom.ini:/usr/local/etc/php/conf.d/nextcloud-custom.ini:ro
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network={{ nextcloud_traefik_docker_network }}"
      - "traefik.http.services.nextcloud.loadbalancer.server.port=80"
      - "traefik.http.routers.nextcloud.rule=Host(`{{ nextcloud_hostname }}`)"
      - "traefik.http.routers.nextcloud.entrypoints=websecure"
      - "traefik.http.routers.nextcloud.tls.certresolver=le"
      - "traefik.http.routers.nextcloud.service=nextcloud"
      - "traefik.http.routers.nextcloud.middlewares=nextcloud-dav,nextcloud-headers"
      # CalDAV/CardDAV well-known redirect — Nextcloud requires this for
      # discovery to work; mobile clients break without it.
      - "traefik.http.middlewares.nextcloud-dav.redirectregex.regex=^https://(.*)/.well-known/(card|cal)dav"
      - "traefik.http.middlewares.nextcloud-dav.redirectregex.replacement=https://$$1/remote.php/dav/"
      - "traefik.http.middlewares.nextcloud-headers.headers.customrequestheaders.X-Forwarded-Proto=https"
      - "traefik.http.middlewares.nextcloud-headers.headers.customrequestheaders.X-Forwarded-For=$$remote_addr"
      - "traefik.http.middlewares.nextcloud-headers.headers.stsincludesubdomains=true"
      - "traefik.http.middlewares.nextcloud-headers.headers.stsseconds=31536000"
      - "traefik.http.middlewares.nextcloud-headers.headers.referrerpolicy=no-referrer"
    networks:
      - "{{ nextcloud_traefik_docker_network }}"
      - nextcloud_network
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          memory: "{{ nextcloud_memory_limit }}"
          cpus: "{{ nextcloud_cpu_limit }}"
        reservations:
          memory: "{{ nextcloud_memory_reservation }}"
          cpus: "{{ nextcloud_cpu_reservation }}"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost/status.php"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 120s

  # Background job runner. Shares the data volume with the app container and
  # invokes cron.php every 5 minutes (image entrypoint handles the scheduling).
  nextcloud-cron:
    image: "{{ nextcloud_image }}:{{ nextcloud_image_tag }}"
    container_name: nextcloud-cron
    restart: always
    depends_on:
      - nextcloud-app
    volumes:
      - nextcloud-data:/var/www/html
    entrypoint: /cron.sh
    environment:
      TZ: "{{ nextcloud_timezone }}"
    networks:
      - nextcloud_network

  # OnlyOffice Document Server. Postgres + Redis live INSIDE the image
  # (default packaging); we don't externalize them. The container is reachable
  # from the Nextcloud container as http://nextcloud-onlyoffice/ for
  # server-to-server callbacks, and from browsers at
  # https://{{ nextcloud_onlyoffice_hostname }} via Traefik.
  nextcloud-onlyoffice:
    image: "{{ nextcloud_onlyoffice_image }}:{{ nextcloud_onlyoffice_image_tag }}"
    container_name: nextcloud-onlyoffice
    restart: always
    env_file:
      - .env
    environment:
      # JWT_SECRET must match what the Nextcloud onlyoffice connector app is
      # configured with — both ends sign every edit-session payload.
      JWT_ENABLED: "true"
      JWT_HEADER: "Authorization"
      JWT_IN_BODY: "false"
      # ALLOW_PRIVATE_IP_ADDRESS=true is required: Nextcloud reaches
      # documentserver via the internal Docker hostname (RFC1918) and the
      # image's nginx otherwise refuses callbacks.
      ALLOW_PRIVATE_IP_ADDRESS: "true"
      ALLOW_META_IP_ADDRESS: "false"
      WOPI_ENABLED: "false"
      METRICS_ENABLED: "false"
      DS_LOG_LEVEL: "WARN"
      DS_WELCOME_PAGE: "false"
      DS_EXAMPLE_ENABLED: "false"
      GENERATE_FONTS: "true"
      NGINX_WORKER_PROCESSES: "auto"
      NGINX_WORKER_CONNECTIONS: "4096"
      # 100MB document upload to the editor is a soft limit; large files still
      # flow through Nextcloud and are referenced by URL.
      NGINX_CLIENT_MAX_BODY_SIZE: "100m"
      NGINX_PROXY_TIMEOUT: "120s"
      NGINX_SEND_TIMEOUT: "120s"
      NGINX_READ_TIMEOUT: "120s"
      TZ: "{{ nextcloud_timezone }}"
    volumes:
      - onlyoffice-data:/var/www/onlyoffice/Data
      - onlyoffice-logs:/var/log/onlyoffice
      - onlyoffice-cache:/var/lib/onlyoffice
      - onlyoffice-fonts:/usr/share/fonts/truetype/custom
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network={{ nextcloud_traefik_docker_network }}"
      - "traefik.http.services.nextcloud-onlyoffice.loadbalancer.server.port=80"
      - "traefik.http.routers.nextcloud-onlyoffice.rule=Host(`{{ nextcloud_onlyoffice_hostname }}`)"
      - "traefik.http.routers.nextcloud-onlyoffice.entrypoints=websecure"
      - "traefik.http.routers.nextcloud-onlyoffice.tls.certresolver=le"
      - "traefik.http.routers.nextcloud-onlyoffice.service=nextcloud-onlyoffice"
      - "traefik.http.routers.nextcloud-onlyoffice.middlewares=nextcloud-onlyoffice-headers"
      - "traefik.http.middlewares.nextcloud-onlyoffice-headers.headers.customrequestheaders.X-Forwarded-Proto=https"
      - "traefik.http.middlewares.nextcloud-onlyoffice-headers.headers.customrequestheaders.X-Forwarded-Host={{ nextcloud_onlyoffice_hostname }}"
    networks:
      - "{{ nextcloud_traefik_docker_network }}"
      - nextcloud_network
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          memory: "{{ nextcloud_onlyoffice_memory_limit }}"
          cpus: "{{ nextcloud_onlyoffice_cpu_limit }}"
        reservations:
          memory: "{{ nextcloud_onlyoffice_memory_reservation }}"
          cpus: "{{ nextcloud_onlyoffice_cpu_reservation }}"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost/healthcheck"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 120s

  # Talk HPB. The aio-talk image bundles eturnal (TURN/STUN), Janus (SFU),
  # and the standalone signaling server behind one supervisord. The wrapper
  # entrypoint patches eturnal at boot: (1) pin the relay address to the
  # public IP that TALK_HOST resolves to — the in-container interface IP is
  # RFC1918 and unreachable from clients; (2) clamp the relay port range to
  # the exact ports we publish below. Both edits are idempotent — they
  # re-apply on every restart.
  nextcloud-talk:
    image: "{{ nextcloud_talk_image }}:{{ nextcloud_talk_image_tag }}"
    container_name: nextcloud-talk
    restart: always
    entrypoint:
      - /bin/bash
      - -c
      - |
        /start.sh
        PUBLIC_IP=$$(dig "$${TALK_HOST}" IN A +short +search | grep '^[0-9.]\+$$' | head -n1)
        if [ -n "$$PUBLIC_IP" ]; then
          sed -i "s|relay_ipv4_addr:.*|relay_ipv4_addr: \"$$PUBLIC_IP\"|" /conf/eturnal.yml
        fi
        sed -i '/secret:/a\  relay_min_port: {{ nextcloud_talk_relay_port_min }}\n  relay_max_port: {{ nextcloud_talk_relay_port_max }}' /conf/eturnal.yml
        exec /usr/bin/supervisord -c /supervisord.conf
    environment:
      NC_DOMAIN: "{{ nextcloud_hostname }}"
      TALK_HOST: "{{ nextcloud_talk_hostname }}"
      TALK_PORT: "{{ nextcloud_talk_turn_port }}"
      TURN_SECRET: "${TALK_TURN_SECRET}"
      SIGNALING_SECRET: "${TALK_SIGNALING_SECRET}"
      INTERNAL_SECRET: "${TALK_INTERNAL_SECRET}"
      TZ: "{{ nextcloud_timezone }}"
    # TURN control port + UDP relay range bind to the host directly. The
    # consumer's security group MUST allow these — Traefik is not in the
    # path. The signaling WSS endpoint (8081 inside the container) is
    # proxied through Traefik on standard 443.
    ports:
      - "{{ nextcloud_talk_turn_port }}:3478/tcp"
      - "{{ nextcloud_talk_turn_port }}:3478/udp"
      - "{{ nextcloud_talk_relay_port_min }}-{{ nextcloud_talk_relay_port_max }}:{{ nextcloud_talk_relay_port_min }}-{{ nextcloud_talk_relay_port_max }}/udp"
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network={{ nextcloud_traefik_docker_network }}"
      - "traefik.http.services.nextcloud-talk.loadbalancer.server.port=8081"
      - "traefik.http.routers.nextcloud-talk.rule=Host(`{{ nextcloud_talk_hostname }}`)"
      - "traefik.http.routers.nextcloud-talk.entrypoints=websecure"
      - "traefik.http.routers.nextcloud-talk.tls.certresolver=le"
      - "traefik.http.routers.nextcloud-talk.service=nextcloud-talk"
    networks:
      - "{{ nextcloud_traefik_docker_network }}"
      - nextcloud_network
    deploy:
      resources:
        limits:
          memory: "{{ nextcloud_talk_memory_limit }}"
          cpus: "{{ nextcloud_talk_cpu_limit }}"
        reservations:
          memory: "{{ nextcloud_talk_memory_reservation }}"
          cpus: "{{ nextcloud_talk_cpu_reservation }}"
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://localhost:8081/api/v1/welcome"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s

volumes:
  redis-data:
  nextcloud-data:
  nextcloud-fontcache:
  nextcloud-wwwcache:
  onlyoffice-data:
  onlyoffice-logs:
  onlyoffice-cache:
  onlyoffice-fonts:

networks:
  nextcloud_network:
    driver: bridge
  "{{ nextcloud_traefik_docker_network }}":
    external: true
