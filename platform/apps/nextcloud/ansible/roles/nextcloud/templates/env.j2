# {{ ansible_managed }}
# Nextcloud environment — DO NOT EDIT MANUALLY.
# Regenerated on every ansible-playbook run from Scaleway Secret Manager.

# ── Domain ──
NEXTCLOUD_TRUSTED_DOMAINS={{ nextcloud_app_secrets.NEXTCLOUD_TRUSTED_DOMAIN }}
OVERWRITEPROTOCOL=https
OVERWRITEHOST={{ nextcloud_app_secrets.NEXTCLOUD_TRUSTED_DOMAIN }}
OVERWRITECLIURL={{ nextcloud_app_secrets.NEXTCLOUD_URL }}
TRUSTED_PROXIES={{ nextcloud_app_secrets.TRUSTED_PROXIES }}
# X-Forwarded-For is handled by Traefik; the Apache mod_rewrite IP swap would
# double-rewrite and break trusted_proxies.
APACHE_DISABLE_REWRITE_IP=1

DEFAULT_PHONE_REGION={{ nextcloud_app_secrets.DEFAULT_PHONE_REGION }}

# ── Identity + scheduling ──
NEXTCLOUD_INSTANCE_NAME={{ nextcloud_instance_name }}
MAINTENANCE_WINDOW_START={{ nextcloud_maintenance_window_start }}

# ── App auto-enable/disable lists (space-separated for shell iteration) ──
NEXTCLOUD_ENABLED_APPS={{ nextcloud_enabled_apps | join(' ') }}
NEXTCLOUD_DISABLED_APPS={{ nextcloud_disabled_apps | join(' ') }}

# ── Optional: n8n webhook receiver for Nextcloud Forms submissions.
# When non-empty, the configure script registers a webhook_listeners hook
# pointed at this URL. Idempotent — script checks existing registrations first.
N8N_FORM_WEBHOOK_URL={{ nextcloud_n8n_form_webhook_url }}

# ── Bootstrap admin (created on first install only) ──
NEXTCLOUD_ADMIN_USER={{ nextcloud_app_secrets.NEXTCLOUD_ADMIN_USER }}
NEXTCLOUD_ADMIN_PASSWORD={{ nextcloud_app_secrets.NEXTCLOUD_ADMIN_PASSWORD | replace('$', '$$') }}

# ── Database (PostgreSQL) ──
POSTGRES_HOST={{ nextcloud_db_credentials.host }}:{{ nextcloud_db_credentials.port }}
POSTGRES_DB={{ nextcloud_db_credentials.dbname }}
POSTGRES_USER={{ nextcloud_db_credentials.username }}
POSTGRES_PASSWORD={{ nextcloud_db_credentials.password | replace('$', '$$') }}

# ── Redis (distributed locking + memcache) ──
REDIS_HOST=nextcloud-redis
REDIS_HOST_PORT=6379
REDIS_HOST_PASSWORD={{ nextcloud_app_secrets.REDIS_PASSWORD | replace('$', '$$') }}
REDIS_PASSWORD={{ nextcloud_app_secrets.REDIS_PASSWORD | replace('$', '$$') }}

# ── S3 primary storage ──
OBJECTSTORE_S3_HOST={{ nextcloud_app_secrets.S3_ENDPOINT_HOST }}
OBJECTSTORE_S3_BUCKET={{ nextcloud_app_secrets.S3_BUCKET }}
OBJECTSTORE_S3_KEY={{ nextcloud_app_secrets.S3_ACCESS_KEY }}
OBJECTSTORE_S3_SECRET={{ nextcloud_app_secrets.S3_SECRET_KEY | replace('$', '$$') }}
OBJECTSTORE_S3_PORT=443
OBJECTSTORE_S3_SSL=true
OBJECTSTORE_S3_REGION={{ nextcloud_app_secrets.S3_REGION }}
OBJECTSTORE_S3_USEPATH_STYLE=false

# ── Secrets the configure script consumes via docker exec env ──
# (Not read directly by Nextcloud; the post-install occ script extracts these.)
OIDC_CLIENT_ID={{ nextcloud_app_secrets.OIDC_CLIENT_ID }}
OIDC_CLIENT_SECRET={{ nextcloud_app_secrets.OIDC_CLIENT_SECRET }}
OIDC_DISCOVERY_URL={{ nextcloud_app_secrets.OIDC_DISCOVERY_URL }}
OIDC_PROVIDER_NAME={{ nextcloud_app_secrets.OIDC_PROVIDER_NAME }}
OIDC_SCOPES={{ nextcloud_app_secrets.OIDC_SCOPES }}

# ── OnlyOffice (read by the documentserver container + the configure script) ──
# JWT_SECRET is the env name the OnlyOffice image reads natively; the
# configure script also fetches it back out to push into Nextcloud's
# onlyoffice connector app config so both sides sign with the same key.
JWT_SECRET={{ nextcloud_app_secrets.ONLYOFFICE_JWT_SECRET | replace('$', '$$') }}
SECURE_LINK_SECRET={{ nextcloud_app_secrets.ONLYOFFICE_SECURE_LINK | replace('$', '$$') }}
ONLYOFFICE_PUBLIC_URL={{ nextcloud_app_secrets.ONLYOFFICE_PUBLIC_URL }}
ONLYOFFICE_INTERNAL_URL={{ nextcloud_app_secrets.ONLYOFFICE_INTERNAL_URL }}
ONLYOFFICE_STORAGE_URL={{ nextcloud_app_secrets.ONLYOFFICE_STORAGE_URL }}

# ── Talk HPB (read by the talk container's entrypoint + configure script) ──
TALK_HOST={{ nextcloud_app_secrets.TALK_HOST }}
TALK_PORT={{ nextcloud_app_secrets.TALK_TURN_PORT }}
TALK_TURN_SECRET={{ nextcloud_app_secrets.TALK_TURN_SECRET | replace('$', '$$') }}
TALK_SIGNALING_SECRET={{ nextcloud_app_secrets.TALK_SIGNALING_SECRET | replace('$', '$$') }}
TALK_INTERNAL_SECRET={{ nextcloud_app_secrets.TALK_INTERNAL_SECRET | replace('$', '$$') }}

{% if nextcloud_smtp_config and nextcloud_smtp_config | length > 0 and nextcloud_app_secrets.SMTP_FROM_EMAIL | length > 0 %}
# ── SMTP ──
SMTP_HOST={{ nextcloud_smtp_config.host }}
SMTP_PORT={{ nextcloud_smtp_config.port }}
SMTP_SECURE={{ nextcloud_smtp_config.use_tls | default('tls') }}
SMTP_AUTHTYPE=LOGIN
SMTP_NAME={{ nextcloud_smtp_config.username }}
SMTP_PASSWORD={{ nextcloud_smtp_config.password | replace('$', '$$') }}
MAIL_FROM_ADDRESS={{ nextcloud_app_secrets.SMTP_FROM_EMAIL.split('@')[0] }}
MAIL_DOMAIN={{ nextcloud_app_secrets.SMTP_FROM_EMAIL.split('@')[1] }}
{% endif %}
