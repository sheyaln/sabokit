# {{ ansible_managed }}
# Broadsheet environment — DO NOT EDIT MANUALLY.
# Regenerated on every ansible-playbook run from Scaleway Secret Manager.

TZ={{ broadsheet_timezone }}

# ── Database ──
DB_HOST={{ broadsheet_db_credentials.host }}
DB_PORT={{ broadsheet_db_credentials.port }}
DB_USER={{ broadsheet_db_credentials.username }}
DB_PASSWORD={{ broadsheet_db_credentials.password | replace('$', '$$') }}
DB_NAME={{ broadsheet_db_credentials.dbname }}

# ── App security ──
# CRITICAL: never change after first boot — encrypts every workspace secret.
SECRET_KEY={{ broadsheet_app_secrets.SECRET_KEY }}
API_ENDPOINT={{ broadsheet_app_secrets.API_ENDPOINT }}

# ── Root admin ──
ROOT_EMAIL={{ broadsheet_app_secrets.ROOT_EMAIL }}
ROOT_ADMIN_EMAIL={{ broadsheet_app_secrets.ROOT_ADMIN_EMAIL }}
ROOT_ADMIN_PASSWORD={{ broadsheet_app_secrets.ROOT_ADMIN_PASSWORD | replace('$', '$$') }}

# ── OIDC (Authentik) ──
OIDC_ENABLED={{ broadsheet_app_secrets.OIDC_ENABLED }}
OIDC_ISSUER_URL={{ broadsheet_app_secrets.OIDC_ISSUER_URL }}
OIDC_CLIENT_ID={{ broadsheet_app_secrets.OIDC_CLIENT_ID }}
OIDC_CLIENT_SECRET={{ broadsheet_app_secrets.OIDC_CLIENT_SECRET }}
OIDC_AUTO_PROVISION={{ broadsheet_app_secrets.OIDC_AUTO_PROVISION }}
OIDC_ALLOW_MAGIC_CODE={{ broadsheet_app_secrets.OIDC_ALLOW_MAGIC_CODE }}

# ── S3 storage (file manager) ──
S3_PROVIDER={{ broadsheet_app_secrets.S3_PROVIDER }}
S3_ENDPOINT={{ broadsheet_app_secrets.S3_ENDPOINT }}
S3_BUCKET={{ broadsheet_app_secrets.S3_BUCKET }}
S3_ACCESS_KEY={{ broadsheet_app_secrets.S3_ACCESS_KEY }}
S3_SECRET_KEY={{ broadsheet_app_secrets.S3_SECRET_KEY }}
S3_REGION={{ broadsheet_app_secrets.S3_REGION }}

{% if broadsheet_smtp_config and broadsheet_smtp_config | length > 0 and broadsheet_app_secrets.SMTP_FROM_EMAIL | length > 0 %}
# ── SMTP ──
SMTP_HOST={{ broadsheet_smtp_config.host }}
SMTP_PORT={{ broadsheet_smtp_config.port }}
SMTP_USERNAME={{ broadsheet_smtp_config.username }}
SMTP_PASSWORD={{ broadsheet_smtp_config.password }}
SMTP_FROM_EMAIL={{ broadsheet_app_secrets.SMTP_FROM_EMAIL }}
SMTP_TLS=true
{% endif %}
