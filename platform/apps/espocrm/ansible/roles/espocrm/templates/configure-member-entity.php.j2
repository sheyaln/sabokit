<?php
// {{ ansible_managed }}
// Opt-in bootstrap: provisions a Member and DuesPayment custom-entity pair,
// the matching roles and teams, and a minimal navbar layout. Aimed at orgs
// using EspoCRM to track constituents/members + dues rather than as a
// generic sales CRM.
//
// Skip this script (espocrm_enable_member_entity_bootstrap = false) if you
// want EspoCRM's default Accounts/Leads/Contacts/Opportunities model.
//
// The entity definitions are intentionally generic — every field reflects
// something most membership orgs need (status, join date, paid-up-through).
// Extend in EspoCRM's Admin UI for org-specific fields; the bootstrap is
// idempotent and won't clobber later UI changes for fields it doesn't own.

$basePath   = '/var/www/html';
$customPath = $basePath . '/custom/Espo/Custom/Resources/metadata';

// EspoCRM's discovery requires the Controller/Entity/Repository PHP classes
// plus the metadata JSON files. Create the layout once.
$directories = [
    $customPath . '/entityDefs',
    $customPath . '/scopes',
    $customPath . '/clientDefs',
    $customPath . '/entityAcl',
    $basePath . '/custom/Espo/Custom/Resources/layouts/Member',
    $basePath . '/custom/Espo/Custom/Resources/layouts/DuesPayment',
    $basePath . '/custom/Espo/Custom/Resources/i18n/en_US',
    $basePath . '/custom/Espo/Custom/Controllers',
    $basePath . '/custom/Espo/Custom/Entities',
    $basePath . '/custom/Espo/Custom/Repositories',
];
foreach ($directories as $dir) {
    if (!is_dir($dir)) {
        mkdir($dir, 0755, true);
    }
}

