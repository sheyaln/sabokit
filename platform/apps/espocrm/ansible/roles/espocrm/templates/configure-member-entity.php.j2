$config['quickCreateList']        = ['Member', 'DuesPayment'];
$config['globalSearchEntityList'] = ['Member', 'DuesPayment'];
file_put_contents($configPath, "<?php\nreturn " . var_export($config, true) . ";\n");
echo "Navigation updated.\n";

// Hide the default sales-CRM entities. Data, if any, is preserved.
$disabled = ['Account', 'Lead', 'Contact', 'Opportunity', 'Case', 'Campaign', 'TargetList', 'Target', 'Document', 'DocumentFolder'];
foreach ($disabled as $entity) {
    writeJson($customPath . "/scopes/$entity.json", ['disabled' => true, 'tab' => false]);
}
