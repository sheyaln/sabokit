// ── Write metadata to disk ─────────────────────────────────────────────────

function writeJson(string $path, array $data): void {
    file_put_contents($path, json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));
}

writeJson($customPath . '/entityDefs/Member.json',          $memberEntityDefs);
writeJson($customPath . '/entityDefs/DuesPayment.json',     $duesPaymentEntityDefs);
writeJson($customPath . '/scopes/Member.json',              $memberScopes);
writeJson($customPath . '/scopes/DuesPayment.json',         $duesPaymentScopes);
writeJson($customPath . '/clientDefs/Member.json',          $memberClientDefs);
writeJson($customPath . '/clientDefs/DuesPayment.json',     $duesPaymentClientDefs);
writeJson($customPath . '/entityAcl/Member.json',           $memberEntityAcl);
writeJson($basePath . '/custom/Espo/Custom/Resources/layouts/Member/detail.json',      $memberDetailLayout);
writeJson($basePath . '/custom/Espo/Custom/Resources/layouts/Member/list.json',        $memberListLayout);
writeJson($basePath . '/custom/Espo/Custom/Resources/layouts/DuesPayment/detail.json', $duesPaymentDetailLayout);
writeJson($basePath . '/custom/Espo/Custom/Resources/layouts/DuesPayment/list.json',   $duesPaymentListLayout);
writeJson($basePath . '/custom/Espo/Custom/Resources/i18n/en_US/Member.json',          $memberLabels);
writeJson($basePath . '/custom/Espo/Custom/Resources/i18n/en_US/DuesPayment.json',     $duesPaymentLabels);
writeJson($basePath . '/custom/Espo/Custom/Resources/i18n/en_US/Global.json',          $globalLabels);

echo "Entity metadata written.\n";

// ── Roles + teams ──────────────────────────────────────────────────────────
// Provisioned via direct SQL so the first apply has them ready before any
// OIDC login attempt. Operators tune via Admin UI afterwards; the upsert
// preserves anything edited that isn't in the data column we write.

$configPath = $basePath . '/data/config.php';
$config     = include($configPath);

$dbHost = $config['database']['host']     ?? '{{ espocrm_db_credentials.host }}';
$dbPort = $config['database']['port']     ?? '{{ espocrm_db_credentials.port }}';
$dbName = $config['database']['dbname']   ?? '{{ espocrm_db_credentials.dbname }}';
$dbUser = $config['database']['user']     ?? '{{ espocrm_db_credentials.username }}';
$dbPass = $config['database']['password'] ?? {{ espocrm_db_credentials.password | to_json }};

$roles = [
    [
        'id'   => 'member_admin_role',
        'name' => 'Member Admin',
        'data' => [
            'Member'      => ['create' => 'yes', 'read' => 'all', 'edit' => 'all', 'delete' => 'all', 'stream' => 'all'],
            'DuesPayment' => ['create' => 'yes', 'read' => 'all', 'edit' => 'all', 'delete' => 'all'],
        ],
        'fieldData' => [
            'Member' => [
                'streetAddress' => ['read' => 'yes', 'edit' => 'yes'],
                'postalCode'    => ['read' => 'yes', 'edit' => 'yes'],
            ],
        ],
    ],
    [
        'id'   => 'member_steward_role',
        'name' => 'Member Steward',
        'data' => [
            'Member'      => ['create' => 'yes', 'read' => 'all', 'edit' => 'all', 'delete' => 'no', 'stream' => 'all'],
            'DuesPayment' => ['create' => 'yes', 'read' => 'all', 'edit' => 'all', 'delete' => 'no'],
        ],
        'fieldData' => [
            'Member' => [
                'streetAddress' => ['read' => 'yes', 'edit' => 'yes'],
                'postalCode'    => ['read' => 'yes', 'edit' => 'yes'],
            ],
        ],
    ],
    [
        'id'   => 'member_viewer_role',
        'name' => 'Member Viewer',
        'data' => [
            'Member'      => ['create' => 'no', 'read' => 'all', 'edit' => 'no', 'delete' => 'no', 'stream' => 'all'],
            'DuesPayment' => ['create' => 'no', 'read' => 'all', 'edit' => 'no', 'delete' => 'no'],
        ],
        'fieldData' => [
            'Member' => [
                'streetAddress' => ['read' => 'no', 'edit' => 'no'],
                'postalCode'    => ['read' => 'no', 'edit' => 'no'],
            ],
        ],
    ],
    [
        'id'   => 'dues_treasurer_role',
        'name' => 'Dues Treasurer',
        'data' => [
            'Member'      => ['create' => 'no', 'read' => 'all', 'edit' => 'no', 'delete' => 'no', 'stream' => 'no'],
            'DuesPayment' => ['create' => 'yes', 'read' => 'all', 'edit' => 'all', 'delete' => 'no'],
        ],
        'fieldData' => [
            'Member' => [
                'streetAddress' => ['read' => 'no', 'edit' => 'no'],
                'postalCode'    => ['read' => 'no', 'edit' => 'no'],
            ],
        ],
    ],
];

try {
    $pdo = new PDO(
        "pgsql:host=$dbHost;port=$dbPort;dbname=$dbName",
        $dbUser,
        $dbPass,
        [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]
    );

    foreach ($roles as $role) {
        $stmt = $pdo->prepare("
            INSERT INTO role (id, name, data, field_data, deleted)
            VALUES (?, ?, ?, ?, false)
            ON CONFLICT (id) DO UPDATE SET
                name = EXCLUDED.name,
                data = EXCLUDED.data,
                field_data = EXCLUDED.field_data,
                deleted = false
        ");
        $stmt->execute([
            $role['id'],
            $role['name'],
            json_encode($role['data']),
            json_encode($role['fieldData']),
        ]);
        echo "Configured role: {$role['name']}\n";
    }

    // One team per role; the SSO team-sync (configured separately) can then
    // place users on the matching team and they pick up role permissions.
    $teams = [
        ['id' => 'memberadmins',    'name' => 'Member Admins',    'roleId' => 'member_admin_role'],
        ['id' => 'memberstewards',  'name' => 'Member Stewards',  'roleId' => 'member_steward_role'],
        ['id' => 'memberviewers',   'name' => 'Member Viewers',   'roleId' => 'member_viewer_role'],
        ['id' => 'duestreasurers',  'name' => 'Dues Treasurers',  'roleId' => 'dues_treasurer_role'],
    ];
    foreach ($teams as $team) {
        $stmt = $pdo->prepare("
            INSERT INTO team (id, name, deleted, created_at)
            VALUES (?, ?, false, NOW())
            ON CONFLICT (id) DO UPDATE SET name = EXCLUDED.name, deleted = false
        ");
        $stmt->execute([$team['id'], $team['name']]);

        $stmt = $pdo->prepare("
            INSERT INTO role_team (role_id, team_id, deleted)
            VALUES (?, ?, false)
            ON CONFLICT (role_id, team_id) DO UPDATE SET deleted = false
        ");
        $stmt->execute([$team['roleId'], $team['id']]);
        echo "Configured team: {$team['name']}\n";
    }
} catch (PDOException $e) {
    fwrite(STDERR, "Database error: " . $e->getMessage() . "\n");
    fwrite(STDERR, "Roles and teams must be configured manually.\n");
}

