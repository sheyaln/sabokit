# {{ ansible_managed }}
# EspoCRM environment — DO NOT EDIT MANUALLY.
# Regenerated on every ansible-playbook run from Scaleway Secret Manager.

TZ={{ espocrm_timezone }}

# EspoCRM's official image reads these on first boot to run the installer
# non-interactively. After the first boot they're effectively no-ops; the
# values of record live in /var/www/html/data/config.php.
ESPOCRM_DATABASE_PLATFORM=Postgresql
ESPOCRM_DATABASE_HOST={{ espocrm_db_credentials.host }}
ESPOCRM_DATABASE_PORT={{ espocrm_db_credentials.port }}
ESPOCRM_DATABASE_NAME={{ espocrm_db_credentials.dbname }}
ESPOCRM_DATABASE_USER={{ espocrm_db_credentials.username }}
ESPOCRM_DATABASE_PASSWORD={{ espocrm_db_credentials.password | replace('$', '$$') }}

ESPOCRM_ADMIN_USERNAME={{ espocrm_app_secrets.ADMIN_USERNAME }}
ESPOCRM_ADMIN_PASSWORD={{ espocrm_app_secrets.ADMIN_PASSWORD | replace('$', '$$') }}

ESPOCRM_SITE_URL={{ espocrm_app_secrets.SITE_URL }}

# ── Consumer-supplied extra env vars ──
{% for key, value in (espocrm_extra_env_vars | default({})).items() %}
{{ key }}={{ value }}
{% endfor %}
