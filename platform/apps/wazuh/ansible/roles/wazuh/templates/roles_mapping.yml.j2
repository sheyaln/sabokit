---
# {{ ansible_managed }}
# Default mapping for the built-in internal users. Customize per-org by
# editing the dashboard's Security UI after first deploy.

_meta:
  type: "rolesmapping"
  config_version: 2

all_access:
  reserved: true
  hidden: false
  backend_roles:
    - "admin"
  description: "Maps admin to all_access"

own_index:
  reserved: false
  hidden: false
  users:
    - "*"
  description: "Allow full access to an index named like the username"

kibana_user:
  reserved: false
  hidden: false
  backend_roles:
    - "kibanauser"
  description: "Maps kibanauser to kibana_user"

readall:
  reserved: true
  hidden: false
  backend_roles:
    - "readall"

manage_snapshots:
  reserved: true
  hidden: false
  backend_roles:
    - "snapshotrestore"
