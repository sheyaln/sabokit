---
# {{ ansible_managed }}
# Maps OIDC `groups` claim values + internal backend roles to opensearch
# roles. The Authentik admin group is mapped straight to all_access so
# admins get the full dashboard.

_meta:
  type: "rolesmapping"
  config_version: 2

all_access:
  reserved: true
  hidden: false
  backend_roles:
    - "admin"
  users:
    - "{{ wazuh_oidc_admin_group }}"
  description: "Maps internal admin + the OIDC admin group to all_access"

own_index:
  reserved: false
  hidden: false
  users:
    - "*"
  description: "Allow full access to an index named like the username"

kibana_user:
  reserved: false
  hidden: false
  backend_roles:
    - "kibanauser"
  users:
    - "*"
  description: "All authenticated users get baseline kibana access"

readall:
  reserved: true
  hidden: false
  backend_roles:
    - "readall"

manage_snapshots:
  reserved: true
  hidden: false
  backend_roles:
    - "snapshotrestore"
