# {{ ansible_managed }}
# Wazuh environment — DO NOT EDIT MANUALLY.

WAZUH_INDEXER_PASSWORD={{ wazuh_app_secrets.WAZUH_INDEXER_PASSWORD | replace('$', '$$') }}
WAZUH_API_PASSWORD={{ wazuh_app_secrets.WAZUH_API_PASSWORD | replace('$', '$$') }}
WAZUH_DASHBOARD_PASSWORD={{ wazuh_app_secrets.WAZUH_DASHBOARD_PASSWORD | replace('$', '$$') }}
OIDC_CLIENT_ID={{ wazuh_app_secrets.OIDC_CLIENT_ID }}
OIDC_CLIENT_SECRET={{ wazuh_app_secrets.OIDC_CLIENT_SECRET | replace('$', '$$') }}
OIDC_DISCOVERY_URL={{ wazuh_app_secrets.OIDC_DISCOVERY_URL }}
OIDC_BASE_REDIRECT_URL={{ wazuh_app_secrets.OIDC_BASE_REDIRECT_URL }}

# ── Consumer-supplied extra env vars ──
{% for key, value in (wazuh_extra_env_vars | default({})).items() %}
{{ key }}={{ value }}
{% endfor %}
