# {{ ansible_managed }}
# Input to wazuh-certs-generator. Hostnames must match the container_name
# of each service in docker-compose.yml; the generator emits one cert
# per node.

nodes:
  indexer:
    - name: wazuh.indexer
      ip: "127.0.0.1"

  server:
    - name: wazuh.manager
      ip: "127.0.0.1"

  dashboard:
    - name: wazuh.dashboard
      ip: "127.0.0.1"
