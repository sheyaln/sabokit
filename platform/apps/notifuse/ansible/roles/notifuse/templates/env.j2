# {{ ansible_managed }}
# Notifuse environment — DO NOT EDIT MANUALLY.
# Regenerated on every ansible-playbook run from Scaleway Secret Manager.

TZ={{ notifuse_timezone }}

# ── Database ──
DB_HOST={{ notifuse_db_credentials.host }}
DB_PORT={{ notifuse_db_credentials.port }}
DB_USER={{ notifuse_db_credentials.username }}
DB_PASSWORD={{ notifuse_db_credentials.password | replace('$', '$$') }}
DB_NAME={{ notifuse_db_credentials.dbname }}

# ── App security ──
# CRITICAL: never change after first boot — encrypts every workspace secret.
SECRET_KEY={{ notifuse_app_secrets.SECRET_KEY }}
API_ENDPOINT={{ notifuse_app_secrets.API_ENDPOINT }}

# ── Root admin ──
ROOT_EMAIL={{ notifuse_app_secrets.ROOT_EMAIL }}
ROOT_ADMIN_EMAIL={{ notifuse_app_secrets.ROOT_ADMIN_EMAIL }}
ROOT_ADMIN_PASSWORD={{ notifuse_app_secrets.ROOT_ADMIN_PASSWORD | replace('$', '$$') }}

# ── OIDC (Authentik) ──
OIDC_ENABLED={{ notifuse_app_secrets.OIDC_ENABLED }}
OIDC_ISSUER_URL={{ notifuse_app_secrets.OIDC_ISSUER_URL }}
OIDC_CLIENT_ID={{ notifuse_app_secrets.OIDC_CLIENT_ID }}
OIDC_CLIENT_SECRET={{ notifuse_app_secrets.OIDC_CLIENT_SECRET }}
OIDC_AUTO_PROVISION={{ notifuse_app_secrets.OIDC_AUTO_PROVISION }}
OIDC_ALLOW_MAGIC_CODE={{ notifuse_app_secrets.OIDC_ALLOW_MAGIC_CODE }}

# ── S3 storage (file manager) ──
S3_PROVIDER={{ notifuse_app_secrets.S3_PROVIDER }}
S3_ENDPOINT={{ notifuse_app_secrets.S3_ENDPOINT }}
S3_BUCKET={{ notifuse_app_secrets.S3_BUCKET }}
S3_ACCESS_KEY={{ notifuse_app_secrets.S3_ACCESS_KEY }}
S3_SECRET_KEY={{ notifuse_app_secrets.S3_SECRET_KEY }}
S3_REGION={{ notifuse_app_secrets.S3_REGION }}

{% if notifuse_smtp_config and notifuse_smtp_config | length > 0 and notifuse_app_secrets.SMTP_FROM_EMAIL | length > 0 %}
# ── SMTP ──
SMTP_HOST={{ notifuse_smtp_config.host }}
SMTP_PORT={{ notifuse_smtp_config.port }}
SMTP_USERNAME={{ notifuse_smtp_config.username }}
SMTP_PASSWORD={{ notifuse_smtp_config.password }}
SMTP_FROM_EMAIL={{ notifuse_app_secrets.SMTP_FROM_EMAIL }}
SMTP_TLS=true
{% endif %}

# ── Consumer-supplied extra env vars ──
{% for key, value in (notifuse_extra_env_vars | default({})).items() %}
{{ key }}={{ value }}
{% endfor %}
