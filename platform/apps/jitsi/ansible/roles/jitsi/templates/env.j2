# {{ ansible_managed }}
# Jitsi environment — DO NOT EDIT MANUALLY.
# Regenerated on every ansible-playbook run from Scaleway Secret Manager.

# JWT — shared between the OIDC adapter (issuer) and prosody (verifier).
JITSI_JWT_APP_SECRET={{ jitsi_app_secrets.JITSI_JWT_APP_SECRET }}

# XMPP component passwords (internal to the prosody container's auth.meet.jitsi domain).
JITSI_JICOFO_AUTH_PASSWORD={{ jitsi_app_secrets.JITSI_JICOFO_AUTH_PASSWORD }}
JITSI_JVB_AUTH_PASSWORD={{ jitsi_app_secrets.JITSI_JVB_AUTH_PASSWORD }}
JITSI_JIBRI_XMPP_PASSWORD={{ jitsi_app_secrets.JITSI_JIBRI_XMPP_PASSWORD }}
JITSI_JIBRI_RECORDER_PASSWORD={{ jitsi_app_secrets.JITSI_JIBRI_RECORDER_PASSWORD }}

# OIDC (Authentik) — consumed by the OIDC adapter, not the Jitsi containers.
JITSI_OIDC_CLIENT_ID={{ jitsi_app_secrets.JITSI_OIDC_CLIENT_ID }}
JITSI_OIDC_CLIENT_SECRET={{ jitsi_app_secrets.JITSI_OIDC_CLIENT_SECRET }}
JITSI_OIDC_DISCOVERY_URL={{ jitsi_app_secrets.JITSI_OIDC_DISCOVERY_URL }}

# ── Consumer-supplied extra env vars ──
{% for key, value in (jitsi_extra_env_vars | default({})).items() %}
{{ key }}={{ value }}
{% endfor %}
