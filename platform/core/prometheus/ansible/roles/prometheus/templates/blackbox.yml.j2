# {{ ansible_managed }}
# Blackbox exporter modules. Most app probes use http_2xx; the rest are
# available for per-target overrides via the prometheus relabel pattern.
# Docs: https://github.com/prometheus/blackbox_exporter/blob/master/CONFIGURATION.md

modules:
  http_2xx:
    prober: http
    timeout: 10s
    http:
      preferred_ip_protocol: ip4
      valid_status_codes: []          # default 200-299
      follow_redirects: true
      fail_if_ssl: false
      fail_if_not_ssl: false
      tls_config:
        insecure_skip_verify: false

  http_4xx_ok:
    # Useful for endpoints that 401/403 by design (admin UIs behind forward-auth).
    # Treats 2xx, 3xx, 401, 403 as a live probe.
    prober: http
    timeout: 10s
    http:
      preferred_ip_protocol: ip4
      valid_status_codes: [200, 201, 204, 301, 302, 401, 403]
      follow_redirects: false

  tcp_connect:
    prober: tcp
    timeout: 5s

  icmp:
    prober: icmp
    timeout: 5s
    icmp:
      preferred_ip_protocol: ip4
