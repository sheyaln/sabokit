# {{ ansible_managed }}
# Grafana alerting contact points. Provisioned via the alerting file provider.
# Only rendered when grafana_jsm_api_key_secret_id is non-empty — see
# tasks/main.yml. JSM Operations (the rebrand of Opsgenie) speaks the heritage
# Opsgenie alerts API; Grafana's native `opsgenie` contact point talks to that
# directly — no custom webhook payload templating needed.
apiVersion: 1

contactPoints:
  - orgId: 1
    name: jsm-default
    receivers:
      - uid: jsm-default
        type: opsgenie
        settings:
          apiKey: "{{ grafana_jsm_secrets.api_key }}"
          apiUrl: "{{ _grafana_jsm_api_url }}"
          autoClose: true
          overridePriority: true
          sendTagsAs: both
          # JSM priority resolves from the alert's `severity` label via a Go
          # template chain rendered from grafana_jsm_priority_mapping. Unknown
          # severities fall back to P5 so nothing pages silently.
          priority: '{% raw %}{{ {% endraw %}{% for sev, prio in grafana_jsm_priority_mapping.items() %}{% if not loop.first %}else {% endif %}if eq .CommonLabels.severity "{{ sev }}"{% raw %} }}{% endraw %}{{ prio }}{% raw %}{{ {% endraw %}{% endfor %}else{% raw %} }}{% endraw %}P5{% raw %}{{ end }}{% endraw %}'
{% if grafana_jsm_alert_tags %}
          tags: "{{ grafana_jsm_alert_tags | join(',') }}"
{% endif %}
        secureSettings: {}
        disableResolveMessage: false
