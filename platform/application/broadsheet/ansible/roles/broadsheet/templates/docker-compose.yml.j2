---
# Managed by sabokit apps/broadsheet/ansible/role.
# Do not edit by hand — regenerated on every ansible-playbook run.
#
# NOTE: the internal docker compose service name remains `notifuse` because
# the bundled binary is the sabokit-broadsheet fork and internal paths
# (in-container references, healthcheck) still assume that name. Traefik
# router + service labels are namespaced `broadsheet` so co-deploying
# alongside the notifuse bundle during migration windows doesn't collide
# on Traefik's router-name uniqueness.

services:
  notifuse:
{% if broadsheet_build_from_source | default(false) %}
    build:
      context: "{{ broadsheet_install_dir }}/src"
      dockerfile: Dockerfile
    image: broadsheet-local:latest
{% else %}
    image: "{{ broadsheet_image }}:{{ broadsheet_image_tag }}"
{% endif %}
    container_name: broadsheet
    restart: unless-stopped
    volumes:
      - "{{ broadsheet_data_dir }}:/app/data"
    env_file:
      - .env
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network={{ broadsheet_traefik_docker_network }}"
      - "traefik.http.services.broadsheet.loadbalancer.server.port=8080"
      - "traefik.http.routers.broadsheet.rule=Host(`{{ broadsheet_hostname }}`)"
      - "traefik.http.routers.broadsheet.entrypoints=websecure"
      - "traefik.http.routers.broadsheet.tls.certresolver=le"
      - "traefik.http.routers.broadsheet.service=broadsheet"
{% if broadsheet_diun_watch_enabled | default(true) %}
      - "diun.enable=true"
{% endif %}
{% if broadsheet_autoheal_enabled | default(false) %}
      - "autoheal=true"
{% endif %}
    networks:
      - "{{ broadsheet_traefik_docker_network }}"
{% for net in broadsheet_extra_docker_networks %}
      - "{{ net }}"
{% endfor %}
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          memory: "{{ broadsheet_memory_limit }}"
          cpus: "{{ broadsheet_cpu_limit }}"
        reservations:
          memory: "{{ broadsheet_memory_reservation }}"
          cpus: "{{ broadsheet_cpu_reservation }}"
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:8080/health >/dev/null 2>&1 || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 30s

networks:
  "{{ broadsheet_traefik_docker_network }}":
    external: true
{% for net in broadsheet_extra_docker_networks %}
  "{{ net }}":
    external: true
{% endfor %}
