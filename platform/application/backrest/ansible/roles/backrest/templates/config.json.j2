{
  "modno": 1,
  "version": 5,
  "instance": "{{ backrest_instance_name }}",
  "auth": {
    "disabled": true
  },
  "repos": [
    {
      "id": "primary",
      "uri": "{{ backrest_app_secrets.RESTIC_REPO_URI }}",
      "password": "{{ backrest_app_secrets.RESTIC_PASSWORD }}",
      "env": [
        "AWS_ACCESS_KEY_ID={{ backrest_app_secrets.AWS_ACCESS_KEY_ID }}",
        "AWS_SECRET_ACCESS_KEY={{ backrest_app_secrets.AWS_SECRET_ACCESS_KEY }}"
      ],
      {# `--option s3.storage-class=<class>` tells restic's S3 backend to
         upload pack/index/snapshot objects directly into the target Scaleway
         storage class, skipping the STANDARD warm window the bucket's
         lifecycle rule would otherwise transition out of after
         `storage_class_transition_days`. Lifecycle rule stays in place to
         migrate any pre-flag-wiring STANDARD objects. #}
      "flags": ["--verbose", "--option", "s3.storage-class={{ backrest_restic_s3_storage_class }}"],
      "autoUnlock": true,
      "autoInitialize": true,
      "prunePolicy": {
        "schedule": { "maxFrequencyDays": {{ backrest_restic_prune_max_frequency_days }} }
      },
      "checkPolicy": {
        "schedule": { "maxFrequencyDays": {{ backrest_restic_check_max_frequency_days }} },
        "readDataSubsetPercent": {{ backrest_restic_check_read_data_subset_pct }}
      }
    }
  ],
  "plans": [
{% for plan in backrest_backup_plans %}
{#
  Effective paths = union of legacy `paths` and the content-aware additions
  (opt_dir, volumes, extra_paths). Restic skips missing paths on a host, so a
  plan emitted for a different host's data is a no-op rather than an error —
  same plug-and-play model as required_inbound_rules.
#}
{% set _opt_path = ['/backup-sources/opt/' ~ plan.id] if plan.opt_dir | default(false) else [] %}
{% set _vol_paths = [] %}
{% for v in plan.volumes | default([]) %}{{ _vol_paths.append('/backup-sources/docker-volumes/' ~ v ~ '/_data') or '' }}{% endfor %}
{# union over legacy + content-aware; dedupe so the belt-and-suspenders `paths` copy doesn't double up with opt_dir-derived path. #}
{% set _eff_paths = ((plan.paths | default([])) + _opt_path + _vol_paths + (plan.extra_paths | default([]))) | unique | list %}
{% set _pre_hooks = plan.pre_hooks | default([]) %}
{% set _post_hooks = plan.post_hooks | default([]) %}
    {
      "id": "{{ plan.id }}",
      "repo": "primary",
      "paths": {{ _eff_paths | to_json }},
{% if plan.excludes is defined and plan.excludes | length > 0 %}
      "excludes": {{ plan.excludes | to_json }},
{% endif %}
{% if _pre_hooks | length > 0 or _post_hooks | length > 0 %}
      "hooks": [
{% set _hooks = [] %}
{% for cmd in _pre_hooks %}{{ _hooks.append({'conditions': ['CONDITION_SNAPSHOT_START'], 'onError': 'ON_ERROR_CANCEL', 'actionCommand': {'command': cmd}}) or '' }}{% endfor %}
{% for cmd in _post_hooks %}{{ _hooks.append({'conditions': ['CONDITION_SNAPSHOT_END'], 'onError': 'ON_ERROR_IGNORE', 'actionCommand': {'command': cmd}}) or '' }}{% endfor %}
{% for h in _hooks %}        {{ h | to_json }}{{ '' if loop.last else ',' }}
{% endfor %}
      ],
{% endif %}
      "schedule": {"cron": "{{ plan.schedule.cron }}"},
      "retention": {
        "policyTimeBucketed": {{ plan.retention | dict2items | rejectattr('value', 'none') | items2dict | to_json }}
      }
    }{{ '' if loop.last else ',' }}
{% endfor %}
  ]
}
