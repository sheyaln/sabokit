      "parameters": {
        "jsCode": "// Expand OCS group members and carry form context from the share item.\nconst members = $json.ocs?.data?.users || [];\nconst context = $('Is Group Share?').item.json;\n\nif (members.length === 0) return [];\n\nreturn members.map(userId => ({\n  json: {\n    userId,\n    formId: context.formId,\n    formHash: context.formHash,\n    formTitle: context.formTitle,\n    submittedBy: context.submittedBy,\n    submittedByUid: context.submittedByUid,\n    submissionId: context.submissionId,\n    submissionTimestamp: context.submissionTimestamp,\n  }\n}));"
      },
