        "options": {
          "rawBody": true
        }
      },
      "id": "wh-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -1040,
        208
      ],
      "webhookId": "nextcloud-form-submission"
    },
    {
      "parameters": {
        "jsCode": "const binaryKeys = Object.keys($binary || {});\n\nif (binaryKeys.length > 0) {\n  try {\n    const buffer = await this.helpers.getBinaryDataBuffer(0, binaryKeys[0]);\n    return [{ json: JSON.parse(buffer.toString('utf-8')) }];\n  } catch (e) {\n    throw new Error(`Binary read failed (key=${binaryKeys[0]}): ${e.message}`);\n  }\n}\n\nif ($json.body) {\n  const raw = $json.body;\n  try {\n    return [{ json: typeof raw === 'string' ? JSON.parse(raw) : raw }];\n  } catch (e) {\n    throw new Error(`Body parse failed (type=${typeof raw}): ${e.message}`);\n  }\n}\n\nthrow new Error(`No data. $json keys: [${Object.keys($json||{}).join(',')}], $binary keys: [${Object.keys($binary||{}).join(',')}]`);"
      },
      "id": "parse-body",
      "name": "Parse Body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -800,
        208
      ]
    },
    {
      "parameters": {
        "url": "=https://nextcloud.example.org/ocs/v2.php/apps/forms/api/v3/forms/{{ $json.event.form.id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "nextCloudApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "OCS-APIRequest",
              "value": "true"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "http-get-form",
      "name": "Get Form Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -560,
        208
      ],
      "credentials": {
        "nextCloudApi": {
          "id": "",
          "name": "NextCloud account"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const payload = $('Parse Body').item.json;\n\n// If Get Form Details failed (e.g. 403 - form not shared with svc-n8n),\n// fall back to webhook data and notify the form owner only.\nconst formData = $json.ocs?.data;\nif (!formData) {\n  const form = payload.event.form;\n  return [{\n    json: {\n      shareType: 'user',\n      shareWith: form.ownerId,\n      displayName: form.ownerId,\n      formId: form.id,\n      formHash: form.hash,\n      formTitle: form.title || '(Untitled Form)',\n      submittedBy: payload.user.displayName || 'Anonymous',\n      submittedByUid: payload.user.uid,\n      submissionId: payload.event.submission.id,\n      submissionTimestamp: payload.event.submission.timestamp,\n    }\n  }];\n}\n\nconst form = formData;\nconst notifyList = [];\nconst submittedBy = payload.user.displayName || 'Anonymous';\n\n// Owner always has access to submissions\nnotifyList.push({\n  shareType: 'user',\n  shareWith: form.ownerId,\n  displayName: form.ownerId,\n  formId: form.id,\n  formHash: form.hash,\n  formTitle: form.title,\n  submittedBy,\n  submittedByUid: payload.user.uid,\n  submissionId: payload.event.submission.id,\n  submissionTimestamp: payload.event.submission.timestamp,\n});\n\n// Add shares with 'results' permission (shareType 0=user, 1=group)\nfor (const share of (form.shares || [])) {\n  const canViewResults = Array.isArray(share.permissions)\n    ? share.permissions.includes('results')\n    : false;\n  if (!canViewResults) continue;\n  if (share.shareType === 0 && share.shareWith === form.ownerId) continue;\n\n  notifyList.push({\n    shareType: share.shareType === 1 ? 'group' : 'user',\n    shareWith: share.shareWith,\n    displayName: share.displayName || share.shareWith,\n    formId: form.id,\n    formHash: form.hash,\n    formTitle: form.title,\n    submittedBy,\n    submittedByUid: payload.user.uid,\n    submissionId: payload.event.submission.id,\n    submissionTimestamp: payload.event.submission.timestamp,\n  });\n}\n\n// Deduplicate by shareType:shareWith\nconst seen = new Set();\nreturn notifyList\n  .filter(s => {\n    const key = `${s.shareType}:${s.shareWith}`;\n    if (seen.has(key)) return false;\n    seen.add(key);\n    return true;\n  })\n  .map(item => ({ json: item }));"
      },
