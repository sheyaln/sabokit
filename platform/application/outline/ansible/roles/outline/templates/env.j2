# {{ ansible_managed }}
# Outline environment — DO NOT EDIT MANUALLY.
# Regenerated on every ansible-playbook run from Scaleway Secret Manager.

NODE_ENV=production
LOG_LEVEL=info
PORT=3000

URL={{ outline_app_secrets.OUTLINE_URL }}
SECRET_KEY={{ outline_app_secrets.SECRET_KEY }}
UTILS_SECRET={{ outline_app_secrets.UTILS_SECRET }}

REDIS_URL=redis://outline-redis:6379

# ── Database (PostgreSQL) ──
DATABASE_URL=postgres://{{ outline_db_credentials.username }}:{{ outline_db_credentials.password | replace('$', '$$') }}@{{ outline_db_credentials.host }}:{{ outline_db_credentials.port }}/{{ outline_db_credentials.dbname }}
PGSSLMODE=disable

# ── OIDC (Authentik) ──
OIDC_CLIENT_ID={{ outline_app_secrets.OIDC_CLIENT_ID }}
OIDC_CLIENT_SECRET={{ outline_app_secrets.OIDC_CLIENT_SECRET }}
OIDC_AUTH_URI={{ outline_app_secrets.OIDC_AUTH_URI }}
OIDC_TOKEN_URI={{ outline_app_secrets.OIDC_TOKEN_URI }}
OIDC_USERINFO_URI={{ outline_app_secrets.OIDC_USERINFO_URI }}
OIDC_USERNAME_CLAIM={{ outline_app_secrets.OIDC_USERNAME_CLAIM }}
OIDC_DISPLAY_NAME={{ outline_app_secrets.OIDC_DISPLAY_NAME }}
OIDC_SCOPES={{ outline_app_secrets.OIDC_SCOPES }}
OIDC_LOGOUT_URI={{ outline_app_secrets.OIDC_LOGOUT_URI }}

# ── S3 storage (attachments bucket) ──
FILE_STORAGE=s3
AWS_REGION={{ outline_app_secrets.AWS_REGION }}
AWS_S3_FORCE_PATH_STYLE={{ outline_app_secrets.AWS_S3_FORCE_PATH_STYLE }}
AWS_S3_UPLOAD_BUCKET_NAME={{ outline_app_secrets.AWS_S3_UPLOAD_BUCKET_NAME }}
AWS_S3_UPLOAD_BUCKET_URL={{ outline_app_secrets.AWS_S3_UPLOAD_BUCKET_URL }}
AWS_ACCESS_KEY_ID={{ outline_app_secrets.AWS_ACCESS_KEY_ID }}
AWS_SECRET_ACCESS_KEY={{ outline_app_secrets.AWS_SECRET_ACCESS_KEY }}
AWS_S3_ACL={{ outline_app_secrets.AWS_S3_ACL }}
FILE_STORAGE_UPLOAD_MAX_SIZE={{ outline_app_secrets.FILE_STORAGE_UPLOAD_MAX_SIZE }}

{% if outline_smtp_config and outline_smtp_config | length > 0 and outline_app_secrets.SMTP_FROM_EMAIL | length > 0 %}
# ── SMTP ──
SMTP_FROM_EMAIL={{ outline_app_secrets.SMTP_FROM_EMAIL }}
SMTP_HOST={{ outline_smtp_config.host }}
SMTP_PORT={{ outline_smtp_config.port }}
SMTP_USERNAME={{ outline_smtp_config.username }}
SMTP_PASSWORD={{ outline_smtp_config.password }}
SMTP_SECURE={{ outline_smtp_config.use_tls | default('true') }}
{% endif %}
