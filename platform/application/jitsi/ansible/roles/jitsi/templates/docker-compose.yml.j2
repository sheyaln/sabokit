# {{ ansible_managed }}
# Managed by sabokit apps/jitsi/ansible/role.
# Do not edit by hand — regenerated on every ansible-playbook run.
#
# Networking: every container talks XMPP on the internal `meet.jitsi` bridge.
# Only `web` and `oidc-adapter` are exposed through Traefik. `jvb` binds the
# host's UDP port directly because WebRTC media bypasses Traefik entirely —
# clients open a UDP socket straight to the bridge's public IP.

services:
  # OIDC adapter — brokers between Authentik (OIDC) and Jitsi (JWT).
  # Receives /oidc/* requests, runs the OIDC dance, mints a Jitsi JWT,
  # redirects the user into the room with the token attached.
  oidc-adapter:
    build:
      context: {{ jitsi_install_dir }}/oidc-adapter
      dockerfile: Dockerfile
    image: jitsi-oidc-adapter:local
    container_name: jitsi-oidc-adapter
    restart: unless-stopped
    environment:
      OIDC_CLIENT_ID: ${JITSI_OIDC_CLIENT_ID}
      OIDC_CLIENT_SECRET: ${JITSI_OIDC_CLIENT_SECRET}
      OIDC_DISCOVERY_URL: ${JITSI_OIDC_DISCOVERY_URL}
      OIDC_SCOPE: "openid email profile"
      JITSI_BASE_URL: https://{{ jitsi_hostname }}
      JWT_APP_ID: jitsi
      JWT_APP_SECRET: ${JITSI_JWT_APP_SECRET}
      JWT_SUBJECT: "{{ jitsi_hostname }}"
      # Flask session cookies are signed with the same key as the meeting JWT
      # so sessions survive container restarts without prematurely expiring users.
      FLASK_SECRET_KEY: ${JITSI_JWT_APP_SECRET}
      LOG_LEVEL: {{ jitsi_oidc_log_level }}
    volumes:
      - {{ jitsi_install_dir }}/oidc-adapter/flask_session:/app/flask_session
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network={{ jitsi_traefik_docker_network }}"
      - "traefik.http.services.jitsi-oidc.loadbalancer.server.port=8000"
      - "traefik.http.routers.jitsi-oidc.rule=Host(`{{ jitsi_hostname }}`) && PathPrefix(`/oidc`)"
      - "traefik.http.routers.jitsi-oidc.entrypoints=websecure"
      - "traefik.http.routers.jitsi-oidc.tls.certresolver=le"
      - "traefik.http.routers.jitsi-oidc.service=jitsi-oidc"
      # Priority > the web router's so /oidc/* hits the adapter, not the web UI.
      - "traefik.http.routers.jitsi-oidc.priority=100"
    networks:
      - "{{ jitsi_traefik_docker_network }}"
      - meet.jitsi
    security_opt:
      - no-new-privileges:true

  web:
    image: jitsi/web:{{ jitsi_image_tag }}
    container_name: jitsi-web
    restart: unless-stopped
    volumes:
      - {{ jitsi_install_dir }}/web:/config:Z
      - {{ jitsi_install_dir }}/web/crontabs:/var/spool/cron/crontabs:Z
      - {{ jitsi_install_dir }}/transcripts:/usr/share/jitsi-meet/transcripts:Z
    environment:
      TZ: {{ jitsi_timezone }}
      PUBLIC_URL: https://{{ jitsi_hostname }}
      XMPP_DOMAIN: meet.jitsi
      XMPP_MUC_DOMAIN: muc.meet.jitsi
      XMPP_INTERNAL_MUC_DOMAIN: internal-muc.meet.jitsi
      XMPP_AUTH_DOMAIN: auth.meet.jitsi
      XMPP_RECORDER_DOMAIN: recorder.meet.jitsi
      XMPP_GUEST_DOMAIN: guest.meet.jitsi
      XMPP_BOSH_URL_BASE: http://prosody:5280
      JICOFO_AUTH_USER: focus
      ENABLE_AUTH: 1
      AUTH_TYPE: jwt
      JWT_APP_ID: jitsi
      JWT_APP_SECRET: ${JITSI_JWT_APP_SECRET}
      JWT_ACCEPTED_ISSUERS: jitsi
      JWT_ACCEPTED_AUDIENCES: jitsi
      # web hands off unauthenticated visitors to the adapter, which redirects
      # to Authentik and bounces them back with a JWT in the URL.
      TOKEN_AUTH_URL: https://{{ jitsi_hostname }}/oidc/auth?room={room}
      ENABLE_LOBBY: {{ '1' if jitsi_enable_lobby else '0' }}
      ENABLE_BREAKOUT_ROOMS: {{ '1' if jitsi_enable_breakout_rooms else '0' }}
      ENABLE_AV_MODERATION: 1
      ENABLE_PREJOIN_PAGE: {{ '1' if jitsi_enable_prejoin_page else '0' }}
      ENABLE_WELCOME_PAGE: 1
      ENABLE_CLOSE_PAGE: 1
      ENABLE_GUESTS: 1
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network={{ jitsi_traefik_docker_network }}"
      - "traefik.http.services.jitsi.loadbalancer.server.port=80"
      - "traefik.http.routers.jitsi.rule=Host(`{{ jitsi_hostname }}`)"
      - "traefik.http.routers.jitsi.entrypoints=websecure"
      - "traefik.http.routers.jitsi.tls.certresolver=le"
      - "traefik.http.routers.jitsi.service=jitsi"
{% if jitsi_diun_watch_enabled | default(true) %}
      - "diun.enable=true"
{% endif %}
{% if jitsi_autoheal_enabled | default(false) %}
      - "autoheal=true"
{% endif %}
    networks:
      - "{{ jitsi_traefik_docker_network }}"
      - meet.jitsi
{% for net in jitsi_extra_docker_networks %}
      - "{{ net }}"
{% endfor %}
    depends_on:
      - prosody
    security_opt:
      - no-new-privileges:true

  prosody:
    image: jitsi/prosody:{{ jitsi_image_tag }}
    container_name: jitsi-prosody
    restart: unless-stopped
    expose:
      - "5222"
      - "5269"
      - "5347"
      - "5280"
    volumes:
      - {{ jitsi_install_dir }}/prosody/config:/config:Z
      - {{ jitsi_install_dir }}/prosody/prosody-plugins-custom:/prosody-plugins-custom:Z
    environment:
      TZ: {{ jitsi_timezone }}
      PUBLIC_URL: https://{{ jitsi_hostname }}
      XMPP_DOMAIN: meet.jitsi
      XMPP_MUC_DOMAIN: muc.meet.jitsi
      XMPP_INTERNAL_MUC_DOMAIN: internal-muc.meet.jitsi
      XMPP_AUTH_DOMAIN: auth.meet.jitsi
      XMPP_RECORDER_DOMAIN: recorder.meet.jitsi
      XMPP_GUEST_DOMAIN: guest.meet.jitsi
      XMPP_MODULES: "persistent_lobby"
      XMPP_MUC_MODULES: "muc_wait_for_host"
      XMPP_INTERNAL_MUC_MODULES: ""
      ENABLE_AUTH: 1
      AUTH_TYPE: jwt
      JWT_APP_ID: jitsi
      JWT_APP_SECRET: ${JITSI_JWT_APP_SECRET}
      JWT_ACCEPTED_ISSUERS: jitsi
      JWT_ACCEPTED_AUDIENCES: jitsi
      JWT_ASAP_KEYSERVER: ""
      JWT_ALLOW_EMPTY: 0
      JWT_TOKEN_AUTH_MODULE: token_verification
      JICOFO_AUTH_USER: focus
      JICOFO_AUTH_PASSWORD: ${JITSI_JICOFO_AUTH_PASSWORD}
      JVB_AUTH_USER: jvb
      JVB_AUTH_PASSWORD: ${JITSI_JVB_AUTH_PASSWORD}
      JIBRI_XMPP_USER: jibri
      JIBRI_XMPP_PASSWORD: ${JITSI_JIBRI_XMPP_PASSWORD}
      JIBRI_RECORDER_USER: recorder
      JIBRI_RECORDER_PASSWORD: ${JITSI_JIBRI_RECORDER_PASSWORD}
      ENABLE_LOBBY: {{ '1' if jitsi_enable_lobby else '0' }}
      ENABLE_GUESTS: 1
      ENABLE_XMPP_WEBSOCKET: 1
    healthcheck:
      test: ["CMD", "/usr/local/bin/healthcheck.sh"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
    networks:
      - meet.jitsi

  jicofo:
    image: jitsi/jicofo:{{ jitsi_image_tag }}
    container_name: jitsi-jicofo
    restart: unless-stopped
    volumes:
      - {{ jitsi_install_dir }}/jicofo:/config:Z
    environment:
      TZ: {{ jitsi_timezone }}
      XMPP_DOMAIN: meet.jitsi
      XMPP_MUC_DOMAIN: muc.meet.jitsi
      XMPP_INTERNAL_MUC_DOMAIN: internal-muc.meet.jitsi
      XMPP_AUTH_DOMAIN: auth.meet.jitsi
      XMPP_SERVER: prosody
      JICOFO_AUTH_USER: focus
      JICOFO_AUTH_PASSWORD: ${JITSI_JICOFO_AUTH_PASSWORD}
      # Verifies room JWTs but doesn't auth jicofo itself against an OIDC IdP.
      ENABLE_AUTH: 1
      JICOFO_ENABLE_AUTH: 0
      AUTH_TYPE: jwt
      SENTRY_DSN: ""
      ENABLE_AUTO_OWNER: 1
      ENABLE_CODEC_VP8: 1
      ENABLE_CODEC_VP9: 1
      ENABLE_CODEC_H264: 1
      ENABLE_CODEC_OPUS_RED: 1
    networks:
      - meet.jitsi
    depends_on:
      - prosody

  jvb:
    image: jitsi/jvb:{{ jitsi_image_tag }}
    container_name: jitsi-jvb
    restart: unless-stopped
    ports:
      # Direct UDP bind — WebRTC media doesn't go through Traefik. Must be
      # opened in the Scaleway security group too; UFW is handled by the role.
      - "{{ jitsi_jvb_udp_port }}:{{ jitsi_jvb_udp_port }}/udp"
    volumes:
      - {{ jitsi_install_dir }}/jvb:/config:Z
    environment:
      TZ: {{ jitsi_timezone }}
      PUBLIC_URL: https://{{ jitsi_hostname }}
      XMPP_DOMAIN: meet.jitsi
      XMPP_MUC_DOMAIN: muc.meet.jitsi
      XMPP_INTERNAL_MUC_DOMAIN: internal-muc.meet.jitsi
      XMPP_AUTH_DOMAIN: auth.meet.jitsi
      XMPP_SERVER: prosody
      JVB_AUTH_USER: jvb
      JVB_AUTH_PASSWORD: ${JITSI_JVB_AUTH_PASSWORD}
      JVB_PORT: {{ jitsi_jvb_udp_port }}
      JVB_STUN_SERVERS: {{ jitsi_jvb_stun_servers }}
      COLIBRI_REST_ENABLED: "true"
      SENTRY_DSN: ""
    healthcheck:
      test: ["CMD", "/usr/local/bin/healthcheck.sh"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
    networks:
      - meet.jitsi
    depends_on:
      - prosody

networks:
  "{{ jitsi_traefik_docker_network }}":
    external: true
{% for net in jitsi_extra_docker_networks %}
  "{{ net }}":
    external: true
{% endfor %}
  meet.jitsi:
    driver: bridge
